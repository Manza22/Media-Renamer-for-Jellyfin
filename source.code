def genre_label(ids, gmap):
    names = [gmap[i] for i in ids[:2] if i in gmap]
    return ", ".join(names) if names else "—"
# ─────────────────────────────────────────────────────────────────────────────
#  PARSING / SCORING
# ─────────────────────────────────────────────────────────────────────────────
_FILMAI = re.compile(r"(?:dataHD_filmai_\d+_\w+_)(.+?)_(\d{4})(?:_\w+)*$", re.I)
# Download sites often use s01_E19 (underscore, 3+ digit ep) for one fake "season".
_TV_SITE = re.compile(r"^(.+?)_[Ss](\d{1,2})_E(\d{1,4})(?:_|\.|$)", re.I)
_TV     = re.compile(r"^(.+?)[. _-]+[Ss](\d{1,2})[. _-]*[Ee](\d{1,4})\b", re.I)
_TV_1X  = re.compile(r"^(.+?)[. _-]+(\d{1,2})[xX](\d{1,4})\b", re.I)
_TV_SE  = re.compile(
    r"^(.+?)[. _-]+(?:[Ss]eason|[Ss])(\d{1,2})[. _-]*(?:[Ee]pisode|[Ee]p?\.?)(\d{1,4})\b", re.I
)
_MOVIE  = re.compile(
    r"^(.+?)[. _\(]+(\d{4})[. _\)]*"
    r"(?:BDRip|BluRay|WEBRip|HDTV|DVDRip|720p|1080p|2160p|4K|x264|x265|HEVC|REMUX)?",
    re.I,
)
_YEAR_TAIL = re.compile(r"^(.+?)[. _-](\d{4})$")
_YEAR_ANY  = re.compile(r"\b(19\d{2}|20[0-3]\d)\b")
_RELEASE_PREFIX = re.compile(r"^(?:\[[^\]]+\]|[{(][^)}\]]+[)}\]]|www\.[^\s]+)[-_. ]+", re.I)
_JUNK   = re.compile(
    r"\b(BDRip|BluRay|WEBRip|HDTV|DVDRip|720p|1080p|2160p|4K|UHD|x264|x265|HEVC|AV1|"
    r"HDRip|WEB-DL|WEBDL|REMUX|REPACK|PROPER|EXTENDED|UNRATED|DC|IMAX|"
    r"DTS|AC3|AAC|Atmos|TrueHD|Subbed|Dubbed|Dual[- ]Audio|Multi[- ]Sub|"
    r"LTPro|dataHD|YIFY|RARBG|FGT|EVO|SPARKS|NTb|FLUX)\b",
    re.I,
)
_ARTICLE_RE = re.compile(r"^(the|a|an)\s+", re.I)

def clean(raw: str) -> str:
    s = raw.replace("_", " ").replace(".", " ")
    return " ".join(_JUNK.sub("", s).split()).strip()

def _strip_release_prefix(stem: str) -> str:
    s = stem
    for _ in range(4):
        n = _RELEASE_PREFIX.sub("", s, count=1)
        if n == s:
            break
        s = n
    return s

def normalize_title(s: str) -> str:
    """Canonical form for fuzzy title comparison."""
    s = clean(s).lower()
    s = s.replace("&", " and ")
    s = re.sub(r"[^\w\s]", " ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return _ARTICLE_RE.sub("", s)

def _title_case_query(s: str) -> str:
    """Title-case each word so TMDB gets e.g. Dragon Ball, not only dragon ball."""
    return " ".join(w[:1].upper() + w[1:].lower() if w else "" for w in s.split())

def _token_overlap(a: str, b: str) -> float:
    aw = set(normalize_title(a).split())
    bw = set(normalize_title(b).split())
    if not aw or not bw:
        return 0.0
    inter = len(aw & bw)
    return inter / max(len(aw), len(bw))

def _sequence_ratio(a: str, b: str) -> float:
    na, nb = normalize_title(a), normalize_title(b)
    if not na or not nb:
        return 0.0
    return SequenceMatcher(None, na, nb).ratio()

def _title_similarity(query: str, *candidates: str) -> float:
    best = 0.0
    for cand in candidates:
        if not cand:
            continue
        best = max(
            best,
            _token_overlap(query, cand),
            _sequence_ratio(query, cand),
            0.85 * _token_overlap(query, cand) + 0.15 * _sequence_ratio(query, cand),
        )
    return best

def _parse_year(y: str | None) -> int | None:
    if not y or len(y) != 4 or not y.isdigit():
        return None
    yi = int(y)
    return yi if 1900 <= yi <= 2035 else None

def parse_stem(stem: str):
    stem = _strip_release_prefix(stem)
    m = _FILMAI.match(stem)
    if m:
        return clean(m.group(1)), m.group(2), "movie"
    m = _TV_SITE.match(stem)
    if m:
        return clean(m.group(1)), None, ("tv", int(m.group(2)), int(m.group(3)))
    for pat in (_TV, _TV_1X, _TV_SE):
        m = pat.match(stem)
        if m:
            return clean(m.group(1)), None, ("tv", int(m.group(2)), int(m.group(3)))
    m = _MOVIE.match(stem)
    if m:
        t = clean(m.group(1))
        if t:
            return t, m.group(2), "movie"
    m = _YEAR_TAIL.match(stem)
    if m:
        yi = _parse_year(m.group(2))
        if yi:
            t = clean(m.group(1))
            if t:
                return t, str(yi), "movie"
    t = clean(stem)
    ym = _YEAR_ANY.search(t)
    if ym:
        yi = _parse_year(ym.group(1))
        if yi:
            title_only = clean(t[: ym.start()] + t[ym.end() :])
            if title_only:
                return title_only, str(yi), "movie"
    return t, None, None

def _result_year(r: dict) -> int | None:
    d = (r.get("release_date") or r.get("first_air_date") or "")[:4]
    return _parse_year(d)

def _year_score(query_year: str | None, result_year: int | None) -> float:
    qy = _parse_year(query_year)
    if qy is None or result_year is None:
        return 0.02 if qy is None else -0.02
    diff = abs(qy - result_year)
    if diff == 0:
        return 0.28
    if diff == 1:
        return 0.06
    if diff <= 2:
        return -0.04
    if diff <= 4:
        return -0.14
    return -0.28

def _score(r: dict, title: str, year: str | None, media_type: str | None = None) -> float:
    names = [
        r.get("title") or "",
        r.get("name") or "",
        r.get("original_title") or "",
        r.get("original_name") or "",
    ]
    sim = max(_title_similarity(title, n) for n in names if n)
    ysco = _year_score(year, _result_year(r))
    pop = min(float(r.get("popularity") or 0) / 180.0, 0.12)
    vc = int(r.get("vote_count") or 0)
    vote = 0.06 if vc > 100 else (0.03 if vc > 20 else 0.0)
    rating = float(r.get("vote_average") or 0)
    qual = min(rating / 10.0, 1.0) * 0.06 if vc > 10 else 0.0
    mt = r.get("media_type")
    if media_type and mt and mt != media_type:
        ysco -= 0.35
    # Slight boost when primary English title matches exactly (normalized)
    nt = normalize_title(title)
    for n in names:
        if n and normalize_title(n) == nt:
            sim = max(sim, 0.92)
            break
    return max(0.0, min(sim + ysco + pop + vote + qual, 1.0))

def best_auto(
    results: list,
    title: str,
    year: str | None,
    media_type: str | None = None,
) -> tuple[bool, dict | None, float]:
    """Return (ask_user, best_result, confidence). ask_user=False => auto-accept."""
    if not results:
        return True, None, 0.0
    scored = sorted(
        [(r, _score(r, title, year, media_type)) for r in results[:30]],
        key=lambda x: x[1],
        reverse=True,
    )
    best, top = scored[0]
    second = scored[1][1] if len(scored) > 1 else 0.0
    gap = top - second
    qy = _parse_year(year)
    ry = _result_year(best)
    year_lock = bool(qy and ry and qy == ry)

    if top < 0.38:
        return True, best, top
    # Strong match: high score or exact year + decent title
    if top >= 0.78 and gap >= 0.06:
        return False, best, top
    if year_lock and top >= 0.62 and gap >= 0.05:
        return False, best, top
    if top >= 0.68 and gap >= 0.12:
        return False, best, top
    if top >= 0.58 and gap >= 0.18:
        return False, best, top
    # Ambiguous: runner-up nearly as good
    if len(scored) > 1 and second >= 0.48 and gap < 0.09:
        return True, best, top
    if top < 0.52:
        return True, best, top
    if top >= 0.55 and gap >= 0.10:
        return False, best, top
    return True, best, top
def sanitize(s: str, max_len: int = 180) -> str:
    s = re.sub(r'[<>:"/\\|?*]', "", s)
    s = s.strip(" .")
    if not s:
        return "Unknown"
    if s.upper() in _WIN_RESERVED:
        s = f"_{s}"
    if len(s) > max_len:
        s = s[:max_len].rstrip(" .")
    return s or "Unknown"

def natural_sort_key(s: str):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]

def build_tv_episode_filename(show_name: str, season: int, episode: int,
                              ep_title: str | None = None, ext: str = "") -> str:
    show = sanitize(show_name)
    if ep_title:
        return f"{show} - S{season:02d}E{episode:02d} - {sanitize(ep_title)}{ext}"
    return f"{show} - S{season:02d}E{episode:02d}{ext}"


def parse_tv_episode_from_name(fname_or_stem: str) -> tuple[int, int] | None:
    """Return (season, episode) parsed from a filename stem, or None."""
    stem = os.path.splitext(fname_or_stem)[0]
    stem = _strip_release_prefix(stem)
    for pat in (_TV_SITE, _TV, _TV_1X, _TV_SE):
        m = pat.match(stem)
        if m:
            return int(m.group(2)), int(m.group(3))
    return None


def tmdb_season_layout(tmdb, tv_id: int) -> list[tuple[int, int]]:
    """TMDB (season_number, episode_count) for seasons 1..N (skips specials)."""
    details = tmdb.tv_details(tv_id) or {}
    out: list[tuple[int, int]] = []
    for s in sorted(details.get("seasons") or [], key=lambda x: x.get("season_number", 0)):
        sn = s.get("season_number")
        if sn is None or int(sn) < 1:
            continue
        count = int(s.get("episode_count") or 0)
        if count <= 0:
            count = len(tmdb.season(tv_id, int(sn)))
        if count > 0:
            out.append((int(sn), count))
    return out


def absolute_episode_to_season_episode(
    absolute: int, layout: list[tuple[int, int]],
) -> tuple[int, int] | None:
    """Map 1-based absolute episode index across the full series to (season, episode)."""
    if absolute < 1 or not layout:
        return None
    n = absolute
    for season_num, ep_count in layout:
        if n <= ep_count:
            return season_num, n
        n -= ep_count
    return None


def flat_season_remapped_episode(
    download_season: int,
    download_episode: int,
    layout: list[tuple[int, int]],
) -> tuple[int, int] | None:
    """When a site labels every file as S01, remap by absolute episode number."""
    if not layout or download_episode < 1:
        return None
    s1_eps = next((c for sn, c in layout if sn == 1), None)
    if s1_eps is None:
        return None
    if download_season == 1 and download_episode > s1_eps:
        return absolute_episode_to_season_episode(download_episode, layout)
    return None


def resolve_tv_season_episode(
    tmdb,
    tv_id: int,
    download_season: int,
    download_episode: int,
    *,
    flat_remap_enabled: bool = True,
) -> tuple[int, int, bool, str]:
    """Return (season, episode, was_remapped, short_note_for_status)."""
    if not flat_remap_enabled:
        return download_season, download_episode, False, ""
    layout = tmdb_season_layout(tmdb, tv_id)
    mapped = flat_season_remapped_episode(download_season, download_episode, layout)
    if not mapped:
        return download_season, download_episode, False, ""
    rs, re = mapped
    if rs == download_season and re == download_episode:
        return download_season, download_episode, False, ""
    return rs, re, True, f"↪ S{download_season:02d}E{download_episode:02d}→S{rs:02d}E{re:02d}"


# folder name (lowercase) → TMDB genre name used for routing
FOLDER_TO_TMDB_GENRE = {
    "sci-fi": "science fiction", "scifi": "science fiction", "sci fi": "science fiction", "sf": "science fiction",
    "science fiction": "science fiction",
    "kids": "family", "children": "family", "family": "family",
    "romance": "romance", "romantic": "romance",
    "action": "action", "acion": "action", "aciton": "action", "acton": "action", "actio": "action",
    "comedy": "comedy", "drama": "drama",
    "horror": "horror", "thriller": "thriller", "fantasy": "fantasy",
    "animation": "animation", "animated": "animation", "animated movies": "animation",
    "documentary": "documentary", "docs": "documentary",
    "adventure": "adventure", "crime": "crime", "mystery": "mystery",
    "war": "war", "western": "western", "musical": "music", "music": "music",
}
# Wrong folder name on disk → correct display name (for rename tool)
FOLDER_CANONICAL_RENAME = {
    "acion": "Action",
    "aciton": "Action",
    "acton": "Action",
    "actio": "Action",
    "sci fi": "Sci-Fi",
    "scifi": "Sci-Fi",
    "science fiction": "Sci-Fi",
    "sf": "Sci-Fi",
    "documentry": "Documentary",
    "documentaries": "Documentary",
    "docs": "Documentary",
    "thriler": "Thriller",
    "romanic": "Romance",
    "horor": "Horror",
    "comedie": "Comedy",
    "fantacy": "Fantasy",
    "adventre": "Adventure",
    "crim": "Crime",
}
# When several TMDB genres match, pick folder in this order (prevents Spider-Man → Sci-Fi)
MOVIE_GENRE_ROUTE_PRIORITY = (
    "action",
    "adventure",
    "comedy",
    "crime",
    "drama",
    "fantasy",
    "horror",
    "thriller",
    "mystery",
    "romance",
    "animation",
    "documentary",
    "family",
    "war",
    "western",
    "music",
    "science fiction",
)
_SUPERHERO_TITLE_HINTS = (
    "spider-man", "spiderman", "batman", "superman", "iron man", "ironman",
    "avengers", "deadpool", "wolverine", "x-men", "xmen", "marvel",
    "guardians of the galaxy", "thor", "captain america", "ant-man",
    "black panther", "doctor strange", "daredevil", "fantastic four",
    "the flash", "aquaman", "suicide squad", "justice league", "hulk",
    "green lantern", "shazam", "venom", "morbius", "blue beetle",
)
# top-level server folders that are libraries, not genre buckets
SERVER_LIBRARY_NAMES = frozenset({
    "movies", "movie", "films", "film",
    "tv shows", "tv", "television", "series", "shows",
    "anime", "music", "photos", "pictures", "collections",
    "incoming", "downloads", "temp", "tmp", ".trash", "$recycle.bin",
    "system volume information",
})

def _is_superhero_title(title: str) -> bool:
    t = re.sub(r"[^a-z0-9]+", " ", (title or "").lower())
    return any(h in t for h in _SUPERHERO_TITLE_HINTS)

def register_genre_folder(gmap: dict, folder_name: str, parent_path: str):
    """Map folder name, typos, and TMDB genre names to the same path."""
    path = os.path.join(parent_path, folder_name)
    key = folder_name.lower().strip()
    gmap[key] = path
    tmdb = FOLDER_TO_TMDB_GENRE.get(key)
    if tmdb:
        gmap[tmdb] = path
        for alias, genre in FOLDER_TO_TMDB_GENRE.items():
            if genre == tmdb:
                gmap[alias] = path

def plan_folder_renames(root: str) -> list[tuple[str, str]]:
    """List (old_path, new_path) for genre folders that should be renamed."""
    planned: list[tuple[str, str]] = []
    seen: set[str] = set()
    bases = [root]
    movies_under = os.path.join(root, "movies")
    if os.path.isdir(movies_under):
        bases.append(movies_under)
    for base in bases:
        try:
            names = os.listdir(base)
        except OSError:
            continue
        for name in names:
            full = os.path.join(base, name)
            if not os.path.isdir(full):
                continue
            low = name.lower().strip()
            if low in SERVER_LIBRARY_NAMES:
                continue
            canonical = FOLDER_CANONICAL_RENAME.get(low)
            if not canonical or canonical == name:
                continue
            dest = os.path.join(base, canonical)
            key = os.path.normcase(dest)
            if key in seen or os.path.exists(dest):
                continue
            seen.add(key)
            planned.append((full, dest))
    return planned

def apply_folder_renames(pairs: list[tuple[str, str]]) -> tuple[int, list[str]]:
    ok = 0
    errors: list[str] = []
    for src, dst in pairs:
        try:
            os.rename(src, dst)
            ok += 1
            log_line(f"Renamed folder: {src} -> {dst}")
        except OSError as e:
            errors.append(f"{os.path.basename(src)}: {e}")
    return ok, errors

def genre_folder_for_ids(
    genre_ids: list,
    genre_map: dict,
    title: str = "",
    *,
    genres: GenreCache,
) -> str | None:
    """Pick best genre folder using priority (not first TMDB genre id)."""
    gmap = genres.combined()
    matched: list[str] = []
    for gid in genre_ids or []:
        gname = gmap.get(gid, "").lower()
        if gname and gname in genre_map and gname not in matched:
            matched.append(gname)
    if not matched:
        return None
    matched_set = set(matched)
    if title and _is_superhero_title(title):
        for prefer in ("action", "adventure", "fantasy"):
            if prefer in matched_set:
                return genre_map[prefer]
    for genre in MOVIE_GENRE_ROUTE_PRIORITY:
        if genre in matched_set:
            return genre_map[genre]
    return genre_map.get(matched[0])

def path_under_dir(child: str, parent: str) -> bool:
    if not parent or not child:
        return False
    try:
        return os.path.commonpath(
            [os.path.normcase(os.path.abspath(child)), os.path.normcase(os.path.abspath(parent))]
        ) == os.path.normcase(os.path.abspath(parent))
    except ValueError:
        return False

def iter_movies_inbox_files(movies_dir: str, genre_map: dict):
    """Yield video files under the movies inbox, skipping known genre folders."""
    genre_paths = {os.path.normcase(os.path.abspath(p)) for p in genre_map.values()}
    root = os.path.abspath(movies_dir)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            d for d in dirnames
            if os.path.normcase(os.path.abspath(os.path.join(dirpath, d))) not in genre_paths
        ]
        for fname in sorted(filenames, key=natural_sort_key):
            if os.path.splitext(fname)[1].lower() in VIDEO_EXT:
                yield os.path.join(dirpath, fname)
def _search_queries(title: str, year: str | None) -> list[tuple[str, str | None]]:
    """Build deduped (title, year) search attempts from a parsed title."""
    seen: set[tuple[str, str | None]] = set()
    out: list[tuple[str, str | None]] = []

    def add(t: str, y: str | None):
        t = clean(t)
        if not t:
            return
        # Case-sensitive dedup: TMDB often needs Title Case, not only lowercase.
        key = (t, y)
        if key not in seen:
            seen.add(key)
            out.append((t, y))

    t0 = clean(title)
    y0 = year
    if not y0:
        ym = _YEAR_ANY.search(t0)
        if ym:
            yi = _parse_year(ym.group(1))
            if yi:
                y0 = str(yi)
                t0 = clean(t0[: ym.start()] + t0[ym.end() :])

    add(t0, y0)
    add(t0, None)
    tc = _title_case_query(t0)
    if tc != t0:
        add(tc, y0)
        add(tc, None)
    if _ARTICLE_RE.match(t0):
        add(_ARTICLE_RE.sub("", t0).strip(), y0)
        add(_ARTICLE_RE.sub("", t0).strip(), None)
    else:
        add(f"The {t0}", y0)
        add(f"The {t0}", None)
    words = t0.split()
    if len(words) > 5:
        add(" ".join(words[:5]), y0)
        add(" ".join(words[:5]), None)
    simple = re.sub(r"[^a-zA-Z0-9 ]", "", t0).strip()
    if simple and normalize_title(simple) != normalize_title(t0):
        add(simple, y0)
        add(simple, None)
    for sep in (":", " – ", " - "):
        if sep in t0:
            head = t0.split(sep, 1)[0].strip()
            if head and normalize_title(head) != normalize_title(t0):
                add(head, y0)
                add(head, None)
    words = t0.split()
    if len(words) >= 3:
        for n in range(len(words) - 1, 1, -1):
            prefix = " ".join(words[:n])
            if normalize_title(prefix) != normalize_title(t0):
                add(prefix, y0)
                add(prefix, None)
    return out

def _search_queries_ui(title: str) -> list[str]:
    """Few variants for the search box — fast, still fixes lowercase queries."""
    t0 = clean(title)
    if not t0:
        return []
    seen: set[str] = set()
    out: list[str] = []

    def add(t: str):
        t = clean(t)
        if t and t not in seen:
            seen.add(t)
            out.append(t)

    add(t0)
    tc = _title_case_query(t0)
    if tc != t0:
        add(tc)
    return out

def rank_search_results(results: list, query: str, year: str | None = None) -> list:
    return sorted(
        results,
        key=lambda r: _score(r, query, year, r.get("media_type")),
        reverse=True,
    )

def _merge_tmdb_batch(
    merged: list[dict],
    seen_ids: set[int],
    batch: list[dict],
    media_type: str | None = None,
) -> None:
    for r in batch:
        rid = r.get("id")
        if not rid or rid in seen_ids:
            continue
        seen_ids.add(rid)
        item = dict(r)
        if media_type:
            item.setdefault("media_type", media_type)
        merged.append(item)

def _append_collection_movies(
    tmdb,
    merged: list[dict],
    seen_ids: set[int],
    query: str,
    *,
    max_pages: int = 1,
) -> None:
    """Pull franchise movies from TMDB collections (e.g. Dragon Ball films)."""
    collections: list[dict] = []
    try:
        for page in tmdb.search_collection_pages(query, max_pages=max_pages):
            collections.extend(page)
    except requests.exceptions.RequestException as e:
        log_line(f"collection search failed ({query!r}): {e}")
        return
    for coll in collections[:COLLECTION_SEARCH_LIMIT]:
        cname = coll.get("name") or ""
        if _title_similarity(query, cname) < 0.32:
            continue
        for movie in tmdb.collection_parts(coll.get("id")):
            _merge_tmdb_batch(merged, seen_ids, [movie], "movie")

def _enough_results(merged: list) -> bool:
    return len(merged) >= TMDB_SEARCH_STOP_AT

def search_movie_with_fallback(tmdb, title, year, *, max_pages: int = TMDB_AUTO_SEARCH_PAGES):
    merged: list[dict] = []
    seen_ids: set[int] = set()
    queries = _search_queries(title, year)
    for q, y in queries[:4]:
        if _enough_results(merged):
            break
        year_attempts: list[str | None] = []
        if y:
            year_attempts.append(y)
        year_attempts.append(None)
        tried_years: set[str | None] = set()
        for yy in year_attempts:
            if yy in tried_years or _enough_results(merged):
                continue
            tried_years.add(yy)
            try:
                batches = (
                    tmdb.search_movie_pages(q, yy, max_pages=max_pages)
                    if yy
                    else tmdb.search_movie_pages(q, max_pages=max_pages)
                )
            except requests.exceptions.RequestException as e:
                log_line(f"movie search failed ({q!r}): {e}")
                continue
            for batch in batches:
                _merge_tmdb_batch(merged, seen_ids, batch, "movie")
    if not _enough_results(merged):
        _append_collection_movies(tmdb, merged, seen_ids, title, max_pages=1)
    if len(merged) < 8:
        for q, _ in queries[:2]:
            if _enough_results(merged):
                break
            try:
                for batch in tmdb.search_multi_pages(q, max_pages=1):
                    movies = [r for r in batch if r.get("media_type") == "movie"]
                    _merge_tmdb_batch(merged, seen_ids, movies, "movie")
            except requests.exceptions.RequestException:
                pass
    if not merged:
        log_line(f"TMDB: no movie results for {title!r} ({year})")
        return []
    return rank_search_results(merged, title, year)

def search_tv_with_fallback(tmdb, title, year=None, *, max_pages: int = TMDB_AUTO_SEARCH_PAGES):
    merged: list[dict] = []
    seen_ids: set[int] = set()
    queries = _search_queries(title, year)
    for q, _ in queries[:4]:
        if _enough_results(merged):
            break
        try:
            for batch in tmdb.search_tv_pages(q, max_pages=max_pages):
                _merge_tmdb_batch(merged, seen_ids, batch, "tv")
        except requests.exceptions.RequestException as e:
            log_line(f"tv search failed ({q!r}): {e}")
    if len(merged) < 8:
        for q, _ in queries[:3]:
            if _enough_results(merged):
                break
            try:
                for batch in tmdb.search_multi_pages(q, max_pages=1):
                    shows = [r for r in batch if r.get("media_type") == "tv"]
                    _merge_tmdb_batch(merged, seen_ids, shows, "tv")
            except requests.exceptions.RequestException:
                pass
    if not merged:
        return []
    return rank_search_results(merged, title, year)

@dataclass
class UISearchSession:
    """Incremental TMDB search for the manual search panel (fast first page, load more later)."""
    title: str
    kind: str
    year: str | None
    queries: list[str]
    seen_ids: set[int]
    items: list[dict]
    next_page: int = 2
    collection_done: bool = False
    multi_page: int = 1
    multi_done: bool = False
    api_exhausted: bool = False

    def ranked(self) -> list[dict]:
        return rank_search_results(self.items, self.title, self.year)

    def has_more_api(self) -> bool:
        return not self.api_exhausted and self.next_page <= TMDB_UI_MAX_PAGE


def _ui_want_movie(kind: str) -> bool:
    return kind in ("Movie", "Both")


def _ui_want_tv(kind: str) -> bool:
    return kind in ("TV Show", "Both")


def _ui_fetch_page1(tmdb, q: str, kind: str, year, items: list, seen: set[int]) -> None:
    """One TMDB page for a single query variant."""
    try:
        if kind == "Both":
            batch = tmdb.search_multi(q, page=1)
            _merge_tmdb_batch(items, seen, batch)
            return
        if _ui_want_movie(kind):
            batch = tmdb.search_movie(q, year, page=1)
            _merge_tmdb_batch(items, seen, batch, "movie")
        if _ui_want_tv(kind):
            batch = tmdb.search_tv(q, page=1)
            _merge_tmdb_batch(items, seen, batch, "tv")
    except requests.exceptions.RequestException as e:
        log_line(f"ui search failed ({q!r}, {kind}): {e}")


def ui_search_start(tmdb, title: str, kind: str, year=None) -> UISearchSession:
    """Page 1, primary query only — 1–2 HTTP calls; title-case if results are thin."""
    queries = _search_queries_ui(title)
    seen: set[int] = set()
    items: list[dict] = []
    session = UISearchSession(
        title=title, kind=kind, year=year, queries=queries, seen_ids=seen, items=items,
    )
    _ui_fetch_page1(tmdb, queries[0], kind, year, items, seen)
    if len(items) < TMDB_UI_MIN_RESULTS and len(queries) > 1:
        _ui_fetch_page1(tmdb, queries[1], kind, year, items, seen)
    return session


def ui_search_extend(tmdb, session: UISearchSession) -> int:
    """Fetch the next TMDB page(s). Returns how many new unique items were added."""
    if not session.has_more_api():
        session.api_exhausted = True
        return 0
    before = len(session.items)
    page = session.next_page
    got = False

    for q in session.queries[:2]:
        try:
            if session.kind == "Both":
                batch = tmdb.search_multi(q, page=page)
                if batch:
                    got = True
                    _merge_tmdb_batch(session.items, session.seen_ids, batch)
            else:
                if _ui_want_movie(session.kind):
                    batch = tmdb.search_movie(q, session.year, page=page)
                    if batch:
                        got = True
                        _merge_tmdb_batch(session.items, session.seen_ids, batch, "movie")
                if _ui_want_tv(session.kind):
                    batch = tmdb.search_tv(q, page=page)
                    if batch:
                        got = True
                        _merge_tmdb_batch(session.items, session.seen_ids, batch, "tv")
        except requests.exceptions.RequestException as e:
            log_line(f"ui search p{page} failed ({q!r}): {e}")

    session.next_page += 1

    if not got and not session.collection_done and _ui_want_movie(session.kind):
        _append_collection_movies(tmdb, session.items, session.seen_ids, session.title, max_pages=1)
        session.collection_done = True
        got = len(session.items) > before

    if not got and session.kind == "Both" and not session.multi_done:
        try:
            batch = tmdb.search_multi(session.queries[0], page=session.multi_page)
            if batch:
                got = True
                _merge_tmdb_batch(session.items, session.seen_ids, batch)
            session.multi_page += 1
            if session.multi_page > 3:
                session.multi_done = True
        except requests.exceptions.RequestException:
            session.multi_done = True

    if not got and page >= TMDB_UI_MAX_PAGE:
        session.api_exhausted = True
    elif not got and session.collection_done and (session.multi_done or session.kind != "Both"):
        session.api_exhausted = True

    return len(session.items) - before

def auto_pick_movie(tmdb, title, year):
    results = search_movie_with_fallback(tmdb, title, year)
    return best_auto(results, title, year, "movie")

def auto_pick_tv(tmdb, title, year):
    results = search_tv_with_fallback(tmdb, title, year)
    return best_auto(results, title, year, "tv")

# ─────────────────────────────────────────────────────────────────────────────
#  TMDB CLIENT
# ─────────────────────────────────────────────────────────────────────────────
class TMDB:
    def __init__(self, key, slow_mode: bool = False):
        self.key = key
        self.slow_mode = slow_mode
    def clear_cache(self) -> None:
        global _tmdb_search_cache
        _tmdb_search_cache = {}

    def _cache_key(self, path: str, params: dict) -> tuple:
        return (self.key, path, tuple(sorted((k, str(v)) for k, v in params.items())))

    def _cached_get(self, path: str, **params):
        global _tmdb_search_cache
        key = self._cache_key(path, params)
        hit = _tmdb_search_cache.get(key)
        if hit is not None:
            return hit
        result = self._get(path, **params)
        if len(_tmdb_search_cache) >= 256:
            _tmdb_search_cache.clear()
        _tmdb_search_cache[key] = result
        return result

    def _get(self, path, **params):
        params["api_key"] = self.key
        url = f"{TMDB_BASE}/{path}"
        last_resp = None
        for attempt in range(6):
            if self.slow_mode:
                time.sleep(0.28)
            last_resp = requests.get(url, params=params, timeout=8)
            if last_resp.status_code == 429:
                wait = min(2 ** attempt, 30)
                log_line(f"TMDB 429 on {path}, sleeping {wait}s")
                time.sleep(wait)
                continue
            last_resp.raise_for_status()
            return last_resp.json()
        if last_resp is not None:
            last_resp.raise_for_status()
        raise requests.exceptions.HTTPError("TMDB rate limit exceeded")
    def _search_pages(self, path: str, max_pages: int = TMDB_AUTO_SEARCH_PAGES, **params) -> list[list]:
        """Fetch all TMDB search pages (20 results each) up to max_pages."""
        pages: list[list] = []
        page = 1
        while page <= max_pages:
            data = self._cached_get(path, page=page, **params)
            batch = data.get("results", []) or []
            if batch:
                pages.append(batch)
            total_pages = int(data.get("total_pages") or 1)
            if not batch or page >= total_pages:
                break
            page += 1
        return pages

    def search_movie(self, title, year=None, page=1):
        p = dict(query=title, include_adult=False, page=page)
        if year:
            p["year"] = year
        return self._cached_get("search/movie", **p).get("results", [])

    def search_movie_pages(self, title, year=None, *, max_pages: int = TMDB_AUTO_SEARCH_PAGES):
        p = dict(query=title, include_adult=False)
        if year:
            p["year"] = year
        return self._search_pages("search/movie", max_pages=max_pages, **p)

    def search_tv(self, title, page=1):
        return self._cached_get(
            "search/tv", query=title, include_adult=False, page=page,
        ).get("results", [])

    def search_tv_pages(self, title, *, max_pages: int = TMDB_AUTO_SEARCH_PAGES):
        return self._search_pages("search/tv", max_pages=max_pages, query=title, include_adult=False)

    def search_multi(self, title, page=1):
        res = self._cached_get(
            "search/multi", query=title, include_adult=False, page=page,
        ).get("results", [])
        return [r for r in res if r.get("media_type") in ("movie", "tv")]

    def search_multi_pages(self, title, *, max_pages: int = 1):
        out: list[list] = []
        for batch in self._search_pages("search/multi", max_pages=max_pages, query=title, include_adult=False):
            filtered = [r for r in batch if r.get("media_type") in ("movie", "tv")]
            if filtered:
                out.append(filtered)
        return out

    def search_collection(self, query, page=1):
        return self._cached_get("search/collection", query=query, page=page).get("results", [])

    def search_collection_pages(self, query, *, max_pages: int = 1):
        return self._search_pages("search/collection", max_pages=max_pages, query=query)
    def collection_parts(self, collection_id):
        try:
            return self._get(f"collection/{collection_id}").get("parts", []) or []
        except requests.exceptions.RequestException as e:
            log_line(f"collection {collection_id} parts failed: {e}")
            return []
    def episode(self, tv_id, s, e):
        try:
            return self._get(f"tv/{tv_id}/season/{s}/episode/{e}")
        except requests.exceptions.RequestException as e:
            log_line(f"TMDB episode {tv_id} S{s}E{e}: {e}")
            return None
    def season(self, tv_id, s):
        try:
            return self._get(f"tv/{tv_id}/season/{s}").get("episodes", [])
        except requests.exceptions.RequestException as e:
            log_line(f"TMDB season {tv_id} S{s}: {e}")
            return []
    def tv_details(self, tv_id):
        try:
            return self._get(f"tv/{tv_id}")
        except requests.exceptions.RequestException as e:
            log_line(f"TMDB tv_details {tv_id}: {e}")
            return {}
    def get_by_id(self, media_id, media_type="movie"):
        try:
            r = self._get(f"{media_type}/{media_id}")
            r.setdefault("media_type", media_type)
            return r
        except requests.exceptions.RequestException as e:
            log_line(f"TMDB get_by_id {media_type}/{media_id}: {e}")
            return None
# ─────────────────────────────────────────────────────────────────────────────
#  JELLYFIN API
# ─────────────────────────────────────────────────────────────────────────────
def normalize_jellyfin_url(url: str) -> str:
    """Fix common URL typos and ensure a scheme."""
    u = (url or "").strip()
    u = re.sub(r"^htps://", "https://", u, flags=re.I)
    u = re.sub(r"^httpss://", "https://", u, flags=re.I)
    u = re.sub(r"^htp://", "http://", u, flags=re.I)
    # Strip Jellyfin web UI paths — API root must not include these
    u = re.sub(r"/web(?:/.*)?$", "", u, flags=re.I)
    u = re.sub(r"/$", "", u)
    if u and not re.match(r"^https?://", u, re.I):
        u = "http://" + u
    return u.rstrip("/")


def jellyfin_url_candidates(url: str) -> list[str]:
    """Build likely API roots (plain host, /jellyfin subpath, etc.)."""
    base = normalize_jellyfin_url(url)
    if not base:
        return []
    seen: set[str] = set()
    out: list[str] = []

    def add(u: str):
        u = u.rstrip("/")
        key = u.lower()
        if u and key not in seen:
            seen.add(key)
            out.append(u)

    add(base)
    if re.search(r"/jellyfin$", base, re.I):
        add(re.sub(r"/jellyfin$", "", base, flags=re.I))
    else:
        add(base + "/jellyfin")
    return out


class JellyfinClient:
    """Trigger library scans via Jellyfin REST API (requires admin API key)."""

    def __init__(self, base_url: str, api_key: str, resolved_base: str | None = None):
        self.input_url = (base_url or "").strip()
        self.base = normalize_jellyfin_url(base_url)
        self.api_key = (api_key or "").strip()
        self._resolved = (resolved_base or "").strip().rstrip("/") or None

    def configured(self) -> bool:
        return bool(self.base and self.api_key)

    @property
    def api_root(self) -> str:
        return self._resolved or self.base

    def _headers(self) -> dict:
        return {
            "X-Emby-Token": self.api_key,
            "Authorization": f'MediaBrowser Token="{self.api_key}"',
            "Content-Type": "application/json",
            "Accept": "application/json",
        }

    def _request(self, method: str, path: str, **kwargs) -> requests.Response:
        path = path if path.startswith("/") else f"/{path}"
        url = f"{self.api_root}{path}"
        timeout = kwargs.pop("timeout", 30)
        kwargs.setdefault("headers", self._headers())
        return requests.request(method, url, timeout=timeout, **kwargs)

    def discover_api_root(self) -> tuple[bool, str]:
        """Find working API base when user URL returns 404 (reverse proxy / subpath)."""
        headers = self._headers()
        tried: list[str] = []
        for candidate in jellyfin_url_candidates(self.input_url or self.base):
            for probe in ("/System/Info/Public", "/System/Info"):
                url = f"{candidate}{probe}"
                tried.append(url)
                try:
                    r = requests.get(url, headers=headers, timeout=12)
                except requests.exceptions.SSLError as e:
                    return False, (
                        f"SSL certificate error for {candidate}.\n"
                        f"Try http://YOUR-IP:8096 on your home network, or fix HTTPS certs.\n{e}"
                    )
                except requests.exceptions.ConnectionError:
                    continue
                except Exception:
                    continue
                if r.status_code == 200:
                    self._resolved = candidate
                    return True, candidate
                if r.status_code == 401 and probe == "/System/Info":
                    self._resolved = candidate
                    return True, candidate
        hint = (
            "HTTP 404 — Jellyfin API URL not found.\n\n"
            "Try one of these Server URL formats:\n"
            "  • http://192.168.x.x:8096\n"
            "  • https://your-domain.com/jellyfin\n\n"
            "Do NOT use /web or /dashboard in the URL.\n"
            "If Jellyfin is behind nginx, include the subpath (often /jellyfin).\n\n"
            f"Tried:\n  " + "\n  ".join(tried[:6])
        )
        return False, hint

    def test_connection(self) -> tuple[bool, str]:
        if not self.configured():
            return False, "Enter Jellyfin server URL and API key."
        if not self._resolved:
            ok, found = self.discover_api_root()
            if not ok:
                return False, found
        try:
            r = self._request("GET", "/System/Info")
            if r.status_code == 401:
                return False, "Unauthorized — check your Jellyfin API key (needs admin)."
            if r.status_code == 404:
                ok, msg = self.discover_api_root()
                if not ok:
                    return False, msg
                r = self._request("GET", "/System/Info")
            if r.status_code == 404:
                return False, (
                    f"Still 404 at {self.api_root}/System/Info\n"
                    "Use Dashboard → Networking to see your Base URL / port."
                )
            r.raise_for_status()
            info = r.json()
            name = info.get("ServerName") or "Jellyfin"
            ver = info.get("Version") or ""
            return True, f"Connected to {name} at {self.api_root}" + (f" ({ver})" if ver else "")
        except requests.exceptions.ConnectionError:
            return False, (
                f"Cannot reach {self.api_root}\n"
                "Check the server is on, port open (8096), and URL uses http or https."
            )
        except Exception as e:
            return False, friendly_error(e, context="Jellyfin")

    def refresh_all_libraries(self) -> tuple[bool, str]:
        if not self.configured():
            return False, "Jellyfin URL or API key missing."
        if not self._resolved:
            ok, msg = self.discover_api_root()
            if not ok:
                return False, msg
        try:
            r = self._request("POST", "/Library/Refresh", timeout=90)
            if r.status_code in (200, 204):
                log_line(f"Jellyfin library refresh started: {self.api_root}")
                return True, "Jellyfin is scanning all libraries."
            if r.status_code == 401:
                return False, "Unauthorized — API key needs admin access."
            if r.status_code == 404:
                return False, (
                    f"404 on {self.api_root}/Library/Refresh — fix Server URL (see Test)."
                )
            return False, f"HTTP {r.status_code}: {(r.text or '')[:200]}"
        except Exception as e:
            log_line(f"Jellyfin refresh error: {e}")
            return False, friendly_error(e, context="Jellyfin refresh")

    def notify_paths_updated(self, paths: list[str]) -> tuple[bool, str]:
        if not self.configured() or not paths:
            return False, "Nothing to notify."
        if not self._resolved:
            ok, msg = self.discover_api_root()
            if not ok:
                return False, msg
        updates = []
        for p in paths:
            if not p:
                continue
            folder = p if os.path.isdir(p) else os.path.dirname(p)
            if folder and os.path.isdir(folder):
                updates.append({
                    "Path": os.path.abspath(folder),
                    "UpdateType": "Created",
                })
        if not updates:
            return self.refresh_all_libraries()
        try:
            r = self._request(
                "POST", "/Library/Media/Updated", json={"Updates": updates}, timeout=60
            )
            if r.status_code in (200, 204):
                log_line(f"Jellyfin path update: {len(updates)} path(s)")
                return True, f"Jellyfin notified for {len(updates)} path(s)."
            return self.refresh_all_libraries()
        except Exception:
            return self.refresh_all_libraries()

# ─────────────────────────────────────────────────────────────────────────────
#  HELPERS
# ─────────────────────────────────────────────────────────────────────────────
def bytes_to_photo(raw: bytes, max_w: int, max_h: int):
    if not PIL_OK: return None
    try:
        img = Image.open(io.BytesIO(raw)).convert("RGBA")
        img.thumbnail((max_w, max_h), Image.LANCZOS)
        return ImageTk.PhotoImage(img)
    except Exception: return None
def _all_widgets(w):
    yield w
    for c in w.winfo_children(): yield from _all_widgets(c)
def _set_bg(widget, color):
    try:
        if widget.winfo_class() not in ("TButton","TCombobox","TScrollbar","TSeparator"):
            widget.config(bg=color)
    except Exception: pass
def _toast(root, msg: str, color: str = GREEN, duration: int = 3000):
    t = tk.Toplevel(root)
    t.overrideredirect(True)
    t.attributes("-topmost", True)
    t.configure(bg=color)
    tk.Label(t, text=msg, font=FONT, fg="white", bg=color, padx=18, pady=8).pack()
    root.update_idletasks()
    rx, ry, rw = root.winfo_x(), root.winfo_y(), root.winfo_width()
    t.update_idletasks()
    tw = t.winfo_width()
    t.geometry(f"+{rx + rw//2 - tw//2}+{ry + 60}")
    root.after(duration, t.destroy)

def build_tv_path(dest_folder, show_name, season, filename):
    """Build nested TV show path: dest/Show Name/Season XX/filename"""
    show_dir   = os.path.join(dest_folder, sanitize(show_name))
    season_dir = os.path.join(show_dir, f"Season {season:02d}")
    return os.path.join(season_dir, filename)

def _maybe_copy_status(
    status: str,
    op: str,
    genre_ids: list,
    genre_folder_map: dict,
    route_title: str,
    genres: GenreCache,
) -> str:
    if op == "copy" and (status.startswith("Matched") or status in ("Manual", "Cached")):
        gdir = genre_folder_for_ids(
            genre_ids, genre_folder_map, title=route_title, genres=genres,
        )
        if gdir:
            return f"Copy → {os.path.basename(gdir)}"
    return status


def _finalize_outcome_paths(
    fname: str,
    old_path: str,
    folder: str,
    new_name: str,
    type_str: str,
    genre_ids: list,
    genre_str: str,
    status: str,
    tag: str,
    poster_path: str,
    show_name_for_path: str,
    season_for_path: int,
    title: str,
    result: dict | None,
    services: ScanServices,
    genres: GenreCache,
) -> FileMatchOutcome:
    route_title = show_name_for_path or title
    if type_str == "Movie":
        if result:
            route_title = sanitize(result.get("title") or result.get("name") or title)
        elif new_name and new_name != fname:
            route_title = parse_stem(os.path.splitext(new_name)[0])[0]
    dest_folder = services.resolve_dest(type_str, genre_ids, folder, route_title)
    if type_str in ("TV Show", "Anime") and show_name_for_path:
        new_path = build_tv_path(dest_folder, show_name_for_path, season_for_path, new_name)
    else:
        new_path = os.path.join(dest_folder, new_name)
    op = services.plan_file_op(old_path, new_path, type_str, genre_ids)
    status = _maybe_copy_status(
        status, op, genre_ids, services.genre_folder_map, route_title, genres,
    )
    return FileMatchOutcome(
        fname=fname,
        new_name=new_name,
        type_str=type_str,
        genre_str=genre_str,
        status=status,
        tag=tag,
        old_path=old_path,
        new_path=new_path,
        genre_ids=genre_ids,
        poster_path=poster_path,
        op=op,
        result=result,
    )


def resolve_file_match(
    tmdb,
    genres: GenreCache,
    fname: str,
    folder: str,
    id_cache: dict,
    services: ScanServices,
    *,
    cancel_event: threading.Event | None = None,
) -> FileMatchOutcome:
    """Pure matching + path planning (no Tk). Returns manual_job when UI pick is needed."""
    stem, ext = os.path.splitext(fname)
    old_path = os.path.join(folder, fname)
    title, year, type_hint = parse_stem(stem)
    new_name = None
    type_str = "Unknown"
    status = "No Match"
    genre_str = "—"
    genre_ids: list = []
    tag = "no_match"
    poster_path = ""
    show_name_for_path = ""
    season_for_path = 1
    result = None
    matched = False
    manual_via = False
    cache_update = None
    manual_job = None
    conf = 0.0

    if cancel_event and cancel_event.is_set():
        return FileMatchOutcome(
            fname=fname,
            new_name=fname,
            type_str=type_str,
            genre_str=genre_str,
            status="Cancelled",
            tag="no_match",
            old_path=old_path,
            new_path=old_path,
            genre_ids=[],
            poster_path="",
            op="skip",
        )

    try:
        cached = id_cache_get(id_cache, old_path)
        if cached:
            cached_mt = cached.get("media_type", "movie")
            fast = tmdb.get_by_id(cached["id"], cached_mt)
            if fast:
                fast["media_type"] = cached_mt
                if cached_mt == "tv":
                    dl_season = type_hint[1] if isinstance(type_hint, tuple) else 1
                    dl_episode = type_hint[2] if isinstance(type_hint, tuple) else 1
                    season, episode, remapped, remap_note = resolve_tv_season_episode(
                        tmdb, fast["id"], dl_season, dl_episode,
                        flat_remap_enabled=services.flat_season_remap,
                    )
                    show = sanitize(fast.get("name") or fast.get("title") or "")
                    ep = tmdb.episode(fast["id"], season, episode)
                    ept = ep.get("name") if ep else None
                    new_name = build_tv_episode_filename(show, season, episode, ept, ext)
                    genre_ids = fast.get("genre_ids", [])
                    genre_str = genres.label(genre_ids, "tv")
                    type_str = "Anime" if 16 in genre_ids else "TV Show"
                    show_name_for_path = show
                    season_for_path = season
                    status = "Cached" + (f" {remap_note}" if remapped else "")
                else:
                    mtitle = sanitize(fast.get("title") or fast.get("name") or "")
                    date = fast.get("release_date") or ""
                    rel_year = date[:4] if date else year or ""
                    new_name = f"{mtitle} ({rel_year}){ext}" if rel_year else f"{mtitle}{ext}"
                    genre_ids = fast.get("genre_ids", [])
                    genre_str = genres.label(genre_ids, "movie")
                    type_str = "Movie"
                poster_path = fast.get("poster_path") or ""
                if cached_mt != "tv":
                    status = "Cached"
                tag = "matched"
                matched = True
                out = _finalize_outcome_paths(
                    fname, old_path, folder, new_name or fname, type_str, genre_ids,
                    genre_str, status, tag, poster_path, show_name_for_path, season_for_path,
                    title, fast, services, genres,
                )
                out.matched = True
                return out

        if isinstance(type_hint, tuple) and type_hint[0] == "tv":
            _, dl_season, dl_episode = type_hint
            season_for_path = dl_season
            ask, best, conf = auto_pick_tv(tmdb, title, year)
            if ask:
                results = search_tv_with_fallback(tmdb, title, year)
                manual_job = ManualPickJob(
                    api_key="",
                    title=title,
                    results=[dict(r, media_type="tv") for r in results],
                    fname=fname,
                    old_path=old_path,
                    ext=ext,
                    type_hint=type_hint,
                    folder=folder,
                    season=dl_season,
                    episode=dl_episode,
                    conf=conf,
                    media_kind="tv",
                    auto_best=dict(best, media_type="tv") if best else None,
                )
                return FileMatchOutcome(
                    fname=fname,
                    new_name=fname,
                    type_str="Unknown",
                    genre_str="—",
                    status="Pick match…",
                    tag="pending_manual",
                    old_path=old_path,
                    new_path=old_path,
                    genre_ids=[],
                    poster_path="",
                    op="skip",
                    manual_job=manual_job,
                )
            result = best
            if result:
                season, episode, remapped, remap_note = resolve_tv_season_episode(
                    tmdb, result["id"], dl_season, dl_episode,
                    flat_remap_enabled=services.flat_season_remap,
                )
                season_for_path = season
                show = sanitize(result.get("name") or result.get("title") or "")
                ep = tmdb.episode(result["id"], season, episode)
                ept = ep.get("name") if ep else None
                new_name = build_tv_episode_filename(show, season, episode, ept, ext)
                genre_ids = result.get("genre_ids", [])
                genre_str = genres.label(genre_ids, "tv")
                type_str = "Anime" if 16 in genre_ids else "TV Show"
                status = f"Matched ({int(conf * 100)}%)" + (f" {remap_note}" if remapped else "")
                tag = "matched"
                poster_path = result.get("poster_path") or ""
                show_name_for_path = show
                if result.get("id"):
                    cache_update = (old_path, {"id": result["id"], "media_type": "tv"})
                matched = True
        else:
            ask, best, conf = auto_pick_movie(tmdb, title, year)
            if ask:
                results = search_movie_with_fallback(tmdb, title, year)
                manual_job = ManualPickJob(
                    api_key="",
                    title=title,
                    results=[dict(r, media_type="movie") for r in results],
                    fname=fname,
                    old_path=old_path,
                    ext=ext,
                    type_hint=type_hint,
                    folder=folder,
                    conf=conf,
                    media_kind="movie",
                    auto_best=dict(best, media_type="movie") if best else None,
                )
                return FileMatchOutcome(
                    fname=fname,
                    new_name=fname,
                    type_str="Unknown",
                    genre_str="—",
                    status="Pick match…",
                    tag="pending_manual",
                    old_path=old_path,
                    new_path=old_path,
                    genre_ids=[],
                    poster_path="",
                    op="skip",
                    manual_job=manual_job,
                )
            result = best
            if result:
                mtitle = sanitize(result.get("title") or result.get("name") or "")
                date = result.get("release_date") or ""
                rel_year = date[:4] if date else year or ""
                new_name = f"{mtitle} ({rel_year}){ext}" if rel_year else f"{mtitle}{ext}"
                genre_ids = result.get("genre_ids", [])
                genre_str = genres.label(genre_ids, "movie")
                type_str = "Movie"
                status = f"Matched ({int(conf * 100)}%)"
                tag = "matched"
                poster_path = result.get("poster_path") or ""
                if result.get("id"):
                    cache_update = (old_path, {"id": result["id"], "media_type": "movie"})
                matched = True
            else:
                type_str = "Movie"
    except requests.exceptions.RequestException as e:
        return FileMatchOutcome(
            fname=fname,
            new_name=fname,
            type_str=type_str,
            genre_str=genre_str,
            status="API Error",
            tag="no_match",
            old_path=old_path,
            new_path=old_path,
            genre_ids=[],
            poster_path="",
            op="skip",
            api_error=friendly_error(e, context="matching"),
        )

    new_name = new_name or fname
    out = _finalize_outcome_paths(
        fname, old_path, folder, new_name, type_str, genre_ids, genre_str, status, tag,
        poster_path, show_name_for_path, season_for_path, title, result, services, genres,
    )
    out.matched = matched
    out.cache_update = cache_update
    return out


def complete_manual_pick(
    job: ManualPickJob,
    chosen: dict | None,
    tmdb,
    genres: GenreCache,
    services: ScanServices,
    *,
    pick_source: str = "manual",
) -> FileMatchOutcome:
    """Apply user picker result (main thread only)."""
    if not chosen:
        return FileMatchOutcome(
            fname=job.fname,
            new_name=job.fname,
            type_str="Movie" if job.media_kind == "movie" else "Unknown",
            genre_str="—",
            status="No Match",
            tag="no_match",
            old_path=job.old_path,
            new_path=job.old_path,
            genre_ids=[],
            poster_path="",
            op="skip",
        )
    title, year, type_hint = parse_stem(os.path.splitext(job.fname)[0])
    if pick_source == "manual":
        status = "Manual"
        tag = "manual"
    else:
        status = f"Matched ({int(job.conf * 100)}%)"
        tag = "matched"
    if job.media_kind == "tv":
        show = sanitize(chosen.get("name") or chosen.get("title") or "")
        season, episode, remapped, remap_note = resolve_tv_season_episode(
            tmdb, chosen["id"], job.season, job.episode,
            flat_remap_enabled=services.flat_season_remap,
        )
        ep = tmdb.episode(chosen["id"], season, episode)
        ept = ep.get("name") if ep else None
        new_name = build_tv_episode_filename(show, season, episode, ept, job.ext)
        genre_ids = chosen.get("genre_ids", [])
        genre_str = genres.label(genre_ids, "tv")
        type_str = "Anime" if 16 in genre_ids else "TV Show"
        poster_path = chosen.get("poster_path") or ""
        if remapped:
            status = f"{status} {remap_note}"
        cache_update = (job.old_path, {"id": chosen["id"], "media_type": "tv"}) if chosen.get("id") else None
        out = _finalize_outcome_paths(
            job.fname, job.old_path, job.folder, new_name, type_str, genre_ids, genre_str,
            status, tag, poster_path, show, season, title, chosen, services, genres,
        )
        out.matched = True
        out.manual_via = pick_source == "manual"
        out.cache_update = cache_update
        return out
    mtitle = sanitize(chosen.get("title") or chosen.get("name") or "")
    date = chosen.get("release_date") or ""
    rel_year = date[:4] if date else year or ""
    new_name = f"{mtitle} ({rel_year}){job.ext}" if rel_year else f"{mtitle}{job.ext}"
    genre_ids = chosen.get("genre_ids", [])
    genre_str = genres.label(genre_ids, "movie")
    type_str = "Movie"
    poster_path = chosen.get("poster_path") or ""
    cache_update = (job.old_path, {"id": chosen["id"], "media_type": "movie"}) if chosen.get("id") else None
    out = _finalize_outcome_paths(
        job.fname, job.old_path, job.folder, new_name, type_str, genre_ids, genre_str,
        status, tag, poster_path, "", 1, title, chosen, services, genres,
    )
    out.matched = True
    out.manual_via = pick_source == "manual"
    out.cache_update = cache_update
    return out


class ApiKeyWizard(tk.Toplevel):
    """First-run guide: get a free TMDB API key and paste it in."""

    TMDB_API_URL = "https://www.themoviedb.org/settings/api"

    def __init__(self, parent, api_var: tk.StringVar, *, on_save=None):
        super().__init__(parent)
        self.api_var = api_var
        self._on_save = on_save
        self.title("Welcome — TMDB API key")
        self.configure(bg=BG)
        self.geometry("540x400")
        self.resizable(False, False)
        self.transient(parent.winfo_toplevel())
        self.grab_set()
        pad = tk.Frame(self, bg=BG, padx=24, pady=20)
        pad.pack(fill="both", expand=True)
        tk.Label(pad, text="Welcome to Media Renamer", font=FONT_H, fg=ACCENT, bg=BG).pack(anchor="w")
        tk.Label(
            pad,
            text=(
                "This app uses The Movie Database (TMDB) to look up movie and TV titles.\n"
                "You need a free API key (takes about two minutes)."
            ),
            font=FONT,
            fg=FG,
            bg=BG,
            justify="left",
            wraplength=480,
        ).pack(anchor="w", pady=(10, 14))
        steps = tk.Frame(pad, bg=PANEL, padx=14, pady=12)
        steps.pack(fill="x", pady=(0, 14))
        for i, line in enumerate(
            (
                "1. Open themoviedb.org and create a free account (if needed).",
                "2. Go to Settings → API → Request an API key (Developer / Personal).",
                "3. Copy the API Key (v3 auth) and paste it below.",
            ),
            start=1,
        ):
            tk.Label(steps, text=line, font=FONT_SM, fg=FG, bg=PANEL, anchor="w", justify="left").pack(
                anchor="w", pady=2,
            )
        link_row = tk.Frame(pad, bg=BG)
        link_row.pack(fill="x", pady=(0, 10))
        tk.Button(
            link_row,
            text="Open TMDB API settings in browser",
            font=FONT,
            bg=BLUE,
            fg="white",
            relief="flat",
            bd=0,
            padx=12,
            pady=6,
            cursor="hand2",
            command=self._open_tmdb,
        ).pack(side="left")
        tk.Label(link_row, text="  (then paste key here)", font=FONT_SM, fg=DIM, bg=BG).pack(side="left")
        key_row = tk.Frame(pad, bg=BG)
        key_row.pack(fill="x", pady=(0, 12))
        tk.Label(key_row, text="API key:", font=FONT, fg=FG, bg=BG).pack(side="left")
        self._entry = tk.Entry(
            key_row, textvariable=api_var, font=FONT, bg=ENT_BG, fg=FG,
            insertbackground=FG, relief="flat", bd=4, width=42, show="*",
        )
        self._entry.pack(side="left", padx=8, fill="x", expand=True)
        self._show_var = tk.BooleanVar(value=False)
        tk.Checkbutton(
            key_row, text="Show", variable=self._show_var, font=FONT_SM, fg=DIM, bg=BG,
            selectcolor=ENT_BG, activebackground=BG, command=self._toggle_show,
        ).pack(side="left")
        tk.Label(
            pad,
            text="Your key stays on this PC only — it is saved in your user profile, not sent anywhere else.",
            font=FONT_SM,
            fg=DIM,
            bg=BG,
            wraplength=480,
            justify="left",
        ).pack(anchor="w", pady=(0, 12))
        btns = tk.Frame(pad, bg=BG)
        btns.pack(fill="x")
        tk.Button(
            btns, text="Save and continue", font=FONT, bg=GREEN, fg="white",
            relief="flat", bd=0, padx=16, pady=8, command=self._save,
        ).pack(side="left")
        tk.Button(
            btns, text="I'll do this later", font=FONT, bg=ENT_BG, fg=FG,
            relief="flat", bd=0, padx=14, pady=8, command=self.destroy,
        ).pack(side="left", padx=8)
        self._entry.focus_set()
        self.protocol("WM_DELETE_WINDOW", self.destroy)

    def _toggle_show(self):
        self._entry.config(show="" if self._show_var.get() else "*")

    def _open_tmdb(self):
        import webbrowser
        webbrowser.open(self.TMDB_API_URL)

    def _save(self):
        key = self.api_var.get().strip()
        if len(key) < 8:
            messagebox.showwarning(
                "API key needed",
                "Paste your TMDB API key (v3) from themoviedb.org/settings/api",
                parent=self,
            )
            return
        if self._on_save:
            self._on_save()
        self.destroy()


def normalize_search_result(r: dict) -> dict:
    """Ensure TMDB search hits have media_type for override logic."""
    if not r.get("media_type"):
        if r.get("title"):
            r["media_type"] = "movie"
        elif r.get("name"):
            r["media_type"] = "tv"
        else:
            r["media_type"] = "movie"
    return r

# ─────────────────────────────────────────────────────────────────────────────
#  UNDO / HISTORY WINDOW
# ─────────────────────────────────────────────────────────────────────────────
class HistoryWindow(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent)
        self.configure(bg=BG); self.title("Rename History & Undo")
        self.geometry("860x520"); self.grab_set()
        self._history = load_history()
        self._build()
    def _build(self):
        tk.Label(self, text="📋 Rename History", font=FONT_H, fg=ACCENT, bg=BG
                 ).pack(pady=(12,2))
        tk.Label(self, text="Select a batch and click Undo to restore original filenames.",
                 font=FONT_SM, fg=DIM, bg=BG).pack()
        mid = tk.Frame(self, bg=BG); mid.pack(fill="both", expand=True, padx=16, pady=10)
        lf = tk.Frame(mid, bg=BG); lf.pack(side="left", fill="y", padx=(0,8))
        tk.Label(lf, text="Batches", font=FONT_SM, fg=DIM, bg=BG).pack(anchor="w")
        self._batch_lb = tk.Listbox(lf, bg=ENT_BG, fg=FG, selectbackground=BLUE,
                                    font=FONT_SM, width=24, relief="flat",
                                    activestyle="none")
        self._batch_lb.pack(fill="y", expand=True)
        for b in reversed(self._history):
            ts = b["timestamp"][:16].replace("T"," ")
            n  = len(b["renames"])
            self._batch_lb.insert(0, f"{ts}  ({n} files)")
        self._batch_lb.bind("<<ListboxSelect>>", self._on_select)
        rf = tk.Frame(mid, bg=BG); rf.pack(side="left", fill="both", expand=True)
        tk.Label(rf, text="Files in batch", font=FONT_SM, fg=DIM, bg=BG).pack(anchor="w")
        self._file_lb = tk.Listbox(rf, bg=ENT_BG, fg=FG, selectbackground=BLUE,
                                   font=FONT_SM, relief="flat", activestyle="none")
        sb = ttk.Scrollbar(rf, orient="vertical", command=self._file_lb.yview)
        self._file_lb.configure(yscrollcommand=sb.set)
        self._file_lb.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        bot = tk.Frame(self, bg=BG); bot.pack(pady=8)
        self._undo_btn = tk.Button(bot, text="↩ Undo Selected Batch", font=FONT,
                                   bg=ACCENT, fg="white", relief="flat", bd=0,
                                   padx=14, pady=6, state="disabled",
                                   command=self._do_undo)
        self._undo_btn.pack(side="left", padx=6)
        tk.Button(bot, text="🗑 Clear All History", font=FONT, bg=ENT_BG, fg=DIM,
                  relief="flat", bd=0, padx=14, pady=6,
                  command=self._clear_history).pack(side="left", padx=6)
        tk.Button(bot, text="Close", font=FONT, bg=ENT_BG, fg=FG,
                  relief="flat", bd=0, padx=14, pady=6,
                  command=self.destroy).pack(side="left", padx=6)
        self._sel_idx = None
    def _on_select(self, _=None):
        sel = self._batch_lb.curselection()
        if not sel: return
        rev_idx = len(self._history) - 1 - sel[0]
        self._sel_idx = rev_idx
        batch = self._history[rev_idx]
        self._file_lb.delete(0, "end")
        for r in batch["renames"]:
            old = os.path.basename(r["old_path"])
            new = os.path.basename(r["new_path"])
            exists = "✓" if os.path.exists(r["new_path"]) else "✗"
            self._file_lb.insert("end", f"{exists}  {new}  →  {old}")
        self._undo_btn.config(state="normal")
    def _do_undo(self):
        if self._sel_idx is None: return
        batch = self._history[self._sel_idx]
        if not messagebox.askyesno("Confirm Undo",
            f"Restore {len(batch['renames'])} file(s) to original names/locations?"):
            return
        ok, errors = undo_batch(batch)
        self._history.pop(self._sel_idx)
        save_history(self._history)
        if errors:
            messagebox.showwarning("Undo completed with errors",
                f"{ok} restored.\n\nErrors:\n" + "\n".join(errors))
        else:
            messagebox.showinfo("Undo complete", f"✓ {ok} file(s) restored successfully.")
        self.destroy()
    def _clear_history(self):
        if messagebox.askyesno("Clear history", "Delete all rename history? (Cannot be undone.)"):
            save_history([]); self.destroy()
# ─────────────────────────────────────────────────────────────────────────────
#  SEARCH PANEL
# ─────────────────────────────────────────────────────────────────────────────
class SearchPanel(tk.Frame):
    def __init__(self, parent, api_key_var, on_select, target_label=None, **kw):
        super().__init__(parent, bg=BG, relief="flat", bd=0, **kw)
        self._api_key_var = api_key_var
        self._on_select = on_select
        self._target_label = target_label  # (iid) -> display name for active scan row
        self._target_iid = None
        self._selected_result = None
        self._poster_imgs = []
        self._debounce_id = None
        self._result_frames = []
        self._selected_frame = None
        self._result_menu = None
        self._ui_session: UISearchSession | None = None
        self._display_count = 0
        self._load_more_btn: tk.Button | None = None
        self._loading_more = False
        self._tmdb: TMDB | None = None
        self._tmdb_key = ""
        self._build()
    def _build(self):
        top=tk.Frame(self,bg="#161b22"); top.pack(fill="x")
        tk.Label(top,text="🔍 SEARCH & OVERRIDE",font=("Segoe UI",10,"bold"),fg=ACCENT,bg="#161b22",pady=6).pack(side="left")
        self._hint_lbl=tk.Label(top,font=FONT_SM,fg=DIM,bg="#161b22",
            text="Select a file (right) → search here → double-click or right-click a result to apply")
        self._hint_lbl.pack(side="left",padx=14)
        self._target_lbl = tk.Label(
            self, text="", font=("Segoe UI", 9, "bold"), fg=GOLD, bg=BG, anchor="w", padx=12,
        )
        self._target_lbl.pack(fill="x", pady=(0, 2))
        if not PIL_OK:
            tk.Label(top,text="⚠ Install Pillow for poster images  (pip install Pillow)",
                font=FONT_SM,fg=GOLD,bg="#161b22").pack(side="right",padx=10)
        bar=tk.Frame(self,bg=BG); bar.pack(fill="x",padx=10,pady=(6,2))
        tk.Label(bar,text="Title / ID:",font=FONT,fg=FG,bg=BG).pack(side="left")
        self._q_var=tk.StringVar()
        self._entry=tk.Entry(bar,textvariable=self._q_var,font=FONT,bg=ENT_BG,fg=FG,
            insertbackground=FG,relief="flat",bd=4,width=40)
        self._entry.pack(side="left",padx=8)
        self._entry.bind("<Return>",lambda e: self._do_search())
        self._type_var=tk.StringVar(value="Both")
        ttk.Combobox(bar,textvariable=self._type_var,values=["Both","Movie","TV Show"],
            width=9,state="readonly",font=FONT).pack(side="left",padx=(0,8))
        tk.Button(bar,text="Search",font=FONT,bg=ACCENT,fg="white",
            activebackground="#c73350",activeforeground="white",relief="flat",bd=0,
            padx=14,pady=3,command=self._do_search).pack(side="left")
        self._apply_btn = tk.Button(
            bar, text="Apply to file", font=FONT, bg=GREEN, fg="white",
            activebackground="#2ea043", activeforeground="white", relief="flat", bd=0,
            padx=12, pady=3, state="disabled", command=self._apply_selected,
        )
        self._apply_btn.pack(side="left", padx=(6, 0))
        self._status_lbl=tk.Label(bar,text="",font=FONT_SM,fg=DIM,bg=BG)
        self._status_lbl.pack(side="left",padx=12)
        self._result_menu = tk.Menu(self, tearoff=0, bg=ENT_BG, fg=FG, activebackground=BLUE, activeforeground="white")
        self._result_menu.add_command(label="Apply to selected file", command=self._apply_selected)
        outer=tk.Frame(self,bg=BG); outer.pack(fill="x",padx=10,pady=(4,8))
        self._canvas=tk.Canvas(outer,bg=PANEL,highlightthickness=0,height=320)
        vsb=ttk.Scrollbar(outer,orient="vertical",command=self._canvas.yview)
        self._canvas.configure(yscrollcommand=vsb.set)
        self._canvas.pack(side="left",fill="x",expand=True)
        vsb.pack(side="right",fill="y")
        self._inner=tk.Frame(self._canvas,bg=PANEL)
        self._inner_id=self._canvas.create_window((0,0),window=self._inner,anchor="nw")
        self._inner.bind("<Configure>", self._on_inner_configure)
        self._canvas.bind("<Configure>",lambda e: self._canvas.itemconfig(self._inner_id,width=e.width))
        for ev in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self._canvas.bind(ev, self._on_scroll)
        self._build_idle_state()
        ttk.Separator(self,orient="horizontal").pack(fill="x",padx=6)

    def _on_inner_configure(self, _event=None):
        self._canvas.configure(scrollregion=self._canvas.bbox("all"))

    def _on_scroll(self, e):
        if e.num == 4 or e.delta > 0:
            self._canvas.yview_scroll(-1, "units")
        else:
            self._canvas.yview_scroll(1, "units")
        self.after(50, self._check_scroll_end)

    def _check_scroll_end(self):
        if not self._ui_session or self._load_more_btn is None:
            return
        try:
            if self._canvas.yview()[1] >= 0.88:
                self._load_more_btn.pack(fill="x", pady=8, padx=12)
        except tk.TclError:
            pass

    def _display_target(self) -> str:
        if not self._target_iid or not self._target_label:
            return ""
        try:
            return self._target_label(self._target_iid) or ""
        except Exception:
            return ""

    def _refresh_target_banner(self):
        name = self._display_target()
        if name:
            self._target_lbl.config(text=f"Applying to: {name}")
        else:
            self._target_lbl.config(text="")

    def load_row(self, iid, title):
        self._target_iid = iid
        self._refresh_target_banner()
        self._hint_lbl.config(
            text="Type a title and Search, then double-click or right-click a result (or Apply to file)"
        )
        self._q_var.set(title)
        self._entry.focus_set()
        self._entry.select_range(0, tk.END)

    def clear_target(self):
        self._target_iid = None
        self._selected_result = None
        self._target_lbl.config(text="")
        self._apply_btn.config(state="disabled")
        self._hint_lbl.config(
            text="Select a file (right) → search here → double-click or right-click a result to apply"
        )
    def _tmdb_client(self, key: str) -> TMDB:
        if self._tmdb is None or self._tmdb_key != key:
            self._tmdb = TMDB(key)
            self._tmdb_key = key
        return self._tmdb

    def _do_search(self):
        q=self._q_var.get().strip(); key=self._api_key_var.get().strip()
        if not q or not key:
            if not key: self._status_lbl.config(text="Enter API key first.")
            return
        self._status_lbl.config(text="Searching TMDB…")
        threading.Thread(target=self._fetch,args=(key,q,self._type_var.get()),daemon=True).start()
    def _fetch(self,key,q,kind):
        try:
            tmdb = self._tmdb_client(key)
            if q.strip().isdigit():
                media_id=int(q.strip())
                candidates=(["movie","tv"] if kind=="Both" else ["movie"] if kind=="Movie" else ["tv"])
                raw=[]
                for mt in candidates:
                    r=tmdb.get_by_id(media_id,mt)
                    if r and (r.get("title") or r.get("name")):
                        r["media_type"]=mt; raw=[r]; break
                if not raw:
                    self.after(0, lambda: self._status_lbl.config(text=f"No TMDB record for ID {media_id}."))
                    self.after(0, self._build_empty_state)
                    return
                self.after(0, lambda r=raw: self._apply_id_results(r))
                return
            session = ui_search_start(tmdb, q, kind, None)
            self.after(0, lambda s=session: self._begin_search_session(s))
        except Exception as exc:
            msg = friendly_error(exc, context="search")
            self.after(0, lambda m=msg: self._status_lbl.config(text=m))

    def _apply_id_results(self, raw):
        ranked = [normalize_search_result(dict(r)) for r in raw]
        self._ui_session = None
        self._status_lbl.config(
            text=f"ID lookup: {ranked[0].get('title') or ranked[0].get('name')}  •  double-click or right-click to apply"
        )
        self._populate_all(ranked)
    def _build_idle_state(self):
        self._ui_session = None
        self._display_count = 0
        for w in self._inner.winfo_children(): w.destroy()
        self._result_frames.clear(); self._poster_imgs.clear(); self._selected_frame=None
        self._load_more_btn = None
        f=tk.Frame(self._inner,bg=PANEL); f.pack(fill="x",pady=30)
        tk.Label(f,text="🎬",font=("Segoe UI",28),fg=DIM,bg=PANEL).pack()
        tk.Label(f,text="Select a file in the scan list (right)",font=("Segoe UI",10,"bold"),fg=DIM,bg=PANEL).pack(pady=(6,2))
        tk.Label(f,text="Right-click it → Search & fix match, or click the row",font=FONT_SM,fg="#4a5568",bg=PANEL).pack()
        tk.Label(f,text="Then double-click or right-click a TMDB result to rename",font=FONT_SM,fg="#4a5568",bg=PANEL).pack()
    def _build_empty_state(self):
        self._ui_session = None
        self._display_count = 0
        for w in self._inner.winfo_children(): w.destroy()
        self._result_frames.clear(); self._poster_imgs.clear(); self._selected_frame=None
        self._load_more_btn = None
        f=tk.Frame(self._inner,bg=PANEL); f.pack(fill="x",pady=20)
        tk.Label(f,text="🔍",font=("Segoe UI",24),fg=DIM,bg=PANEL).pack()
        tk.Label(f,text="No results found",font=("Segoe UI",10,"bold"),fg=FG,bg=PANEL).pack(pady=(6,2))
        tk.Label(f,text="Try editing the title above and pressing Search",font=FONT_SM,fg=DIM,bg=PANEL).pack()
    def _begin_search_session(self, session: UISearchSession):
        self._ui_session = session
        self._display_count = 0
        self._loading_more = False
        ranked = [normalize_search_result(dict(r)) for r in session.ranked()]
        if not ranked:
            self._status_lbl.config(text="No results — try a different query.")
            self._build_empty_state()
            return
        self._populate_all(ranked[:SEARCH_UI_CHUNK])
        self._display_count = min(SEARCH_UI_CHUNK, len(ranked))
        self._update_search_status()

    def _update_search_status(self):
        session = self._ui_session
        if not session:
            return
        total = len(session.ranked())
        shown = self._display_count
        more = (shown < total) or session.has_more_api()
        hint = f"Showing {shown}"
        if total > shown:
            hint += f" of {total} loaded"
        elif more:
            hint += f" of {total}+"
        else:
            hint += f" of {total}"
        if more:
            hint += "  •  scroll down for Load more"
        hint += "  •  double-click or right-click → Apply"
        self._status_lbl.config(text=hint)

    def _clear_result_rows(self):
        for w in self._inner.winfo_children():
            w.destroy()
        self._result_frames.clear()
        self._selected_frame = None
        self._load_more_btn = None

    def _populate_all(self, results, *, append: bool = False):
        if not append:
            self._clear_result_rows()
        if not results and not append:
            self._build_empty_state()
            return
        start_frames = len(self._result_frames)
        for r in results:
            self._build_result_row(r)
        new_frames = self._result_frames[start_frames:]
        if not append and self._result_frames:
            first_frame, first_result, *_ = self._result_frames[0]
            self._select_row(first_frame, first_result)
        if new_frames:
            threading.Thread(
                target=self._load_all_posters,
                args=(list(results), list(new_frames)),
                daemon=True,
            ).start()
        self._place_load_more_button()

    def _place_load_more_button(self):
        if self._load_more_btn:
            self._load_more_btn.destroy()
            self._load_more_btn = None
        session = self._ui_session
        if not session:
            return
        total = len(session.ranked())
        has_buffered = self._display_count < total
        has_api = session.has_more_api()
        if not has_buffered and not has_api:
            return
        label = "Load more results…"
        if has_buffered and not has_api:
            remaining = total - self._display_count
            label = f"Load more ({min(remaining, SEARCH_UI_CHUNK)} of {remaining} remaining)…"
        elif has_api:
            label = "Load more from TMDB…"
        self._load_more_btn = tk.Button(
            self._inner,
            text=label,
            font=FONT,
            bg=ENT_BG,
            fg=FG,
            activebackground=BLUE,
            activeforeground="white",
            relief="flat",
            bd=0,
            padx=12,
            pady=8,
            cursor="hand2",
            command=self._on_load_more,
        )
        self._load_more_btn.pack(fill="x", pady=8, padx=12)
        self._on_inner_configure()

    def _on_load_more(self):
        if self._loading_more or not self._ui_session:
            return
        session = self._ui_session
        ranked = [normalize_search_result(dict(r)) for r in session.ranked()]
        if self._display_count < len(ranked):
            chunk = ranked[self._display_count : self._display_count + SEARCH_UI_CHUNK]
            self._display_count += len(chunk)
            self._populate_all(chunk, append=True)
            self._update_search_status()
            return
        if not session.has_more_api():
            self._place_load_more_button()
            return
        self._loading_more = True
        if self._load_more_btn:
            self._load_more_btn.config(text="Loading…", state="disabled")
        self._status_lbl.config(text="Loading more from TMDB…")
        key = self._api_key_var.get().strip()
        threading.Thread(target=self._fetch_more, args=(key,), daemon=True).start()

    def _fetch_more(self, key: str):
        try:
            tmdb = self._tmdb_client(key)
            session = self._ui_session
            if session is None:
                return
            ui_search_extend(tmdb, session)
            self.after(0, self._on_more_loaded)
        except Exception as exc:
            msg = friendly_error(exc, context="load more")
            self.after(0, lambda m=msg: self._status_lbl.config(text=m))
            self.after(0, self._finish_load_more)

    def _on_more_loaded(self):
        session = self._ui_session
        if not session:
            self._finish_load_more()
            return
        ranked = [normalize_search_result(dict(r)) for r in session.ranked()]
        chunk = ranked[self._display_count : self._display_count + SEARCH_UI_CHUNK]
        self._display_count += len(chunk)
        if chunk:
            self._populate_all(chunk, append=True)
        self._finish_load_more()
        self._update_search_status()

    def _finish_load_more(self):
        self._loading_more = False
        self._place_load_more_button()
    def _build_result_row(self,r):
        mt=r.get("media_type","movie"); title=r.get("title") or r.get("name") or "?"
        year=(r.get("release_date") or r.get("first_air_date") or "")[:4]
        ov=(r.get("overview") or "No overview available.")[:160].replace("\n"," ")
        badge_col="#1a6b3c" if mt=="movie" else "#1a3a6b"
        label="Movie" if mt=="movie" else "TV Show"
        row=tk.Frame(self._inner,bg=PANEL,cursor="hand2"); row.pack(fill="x",padx=2,pady=1)
        pframe=tk.Frame(row,bg="#2d333b",width=SEARCH_POSTER_W,height=SEARCH_POSTER_H)
        pframe.pack_propagate(False); pframe.pack(side="left",padx=(6,0),pady=4)
        plbl=tk.Label(pframe,bg="#2d333b",text="🎬",fg=DIM,font=("Segoe UI",16))
        plbl.place(relx=0.5,rely=0.5,anchor="center")
        info=tk.Frame(row,bg=PANEL); info.pack(side="left",fill="both",expand=True,padx=10,pady=4)
        tr=tk.Frame(info,bg=PANEL); tr.pack(fill="x")
        tk.Label(tr,text=title,font=("Segoe UI",10,"bold"),fg=FG,bg=PANEL,anchor="w").pack(side="left")
        if year: tk.Label(tr,text=f"  {year}",font=FONT_SM,fg=DIM,bg=PANEL).pack(side="left")
        tk.Label(tr,text=f" {label} ",font=("Segoe UI",8,"bold"),fg="white",bg=badge_col,padx=4,pady=1).pack(side="left",padx=8)
        tmdb_id=r.get("id")
        if tmdb_id:
            tk.Label(tr,text=f"ID: {tmdb_id}",font=("Segoe UI",8),fg="#58a6ff",bg=PANEL,padx=2).pack(side="left")
        tk.Label(info,text=ov,font=FONT_SM,fg=DIM,bg=PANEL,wraplength=600,justify="left",anchor="w").pack(fill="x")
        def _hon(e,f=row):
            if f is not self._selected_frame:
                f.config(bg="#1f2933")
                for c in f.winfo_children(): _set_bg(c,"#1f2933")
        def _hoff(e,f=row):
            col=BLUE if f is self._selected_frame else PANEL
            f.config(bg=col)
            for c in f.winfo_children(): _set_bg(c,col)
        def _click(e,f=row,res=r): self._select_row(f,res)
        def _dbl(e,res=r): self.after(10, lambda r=res: self._apply_result(r))
        def _rclick(e,res=r):
            self._select_row(row, res)
            self._popup_result_menu(e, res)
        for w in _all_widgets(row):
            w.bind("<Enter>",_hon); w.bind("<Leave>",_hoff)
            w.bind("<Button-1>",_click)
            for seq in ("<Double-1>", "<Double-Button-1>"):
                w.bind(seq, _dbl)
            w.bind("<Button-3>",_rclick)
        ttk.Separator(self._inner,orient="horizontal").pack(fill="x",padx=4)
        self._result_frames.append((row,r,plbl,pframe))
    def _load_all_posters(self,results,frames):
        cache={}
        for r,(row,_r,plbl,pframe) in zip(results,frames):
            pp=r.get("poster_path")
            if not pp: continue
            try:
                if pp not in cache:
                    resp=requests.get(f"{TMDB_IMG_92}{pp}",timeout=8)
                    if resp.ok: cache[pp]=resp.content
                raw=cache.get(pp)
                if not raw: continue
                photo=bytes_to_photo(raw,SEARCH_POSTER_W,SEARCH_POSTER_H)
                if photo is None: continue
                self._poster_imgs.append(photo)
                def _show(plbl=plbl,pframe=pframe,photo=photo,row=row,res=r):
                    try:
                        plbl.place_forget()
                        il=tk.Label(pframe,image=photo,bg="#2d333b",cursor="hand2")
                        il.image=photo; il.place(relx=0,rely=0,relwidth=1,relheight=1)
                        il.bind("<Button-1>",lambda e,f=row,res=res: self._select_row(f,res))
                        il.bind("<Double-1>",lambda e,res=res: self.after(10, lambda: self._apply_result(res)))
                        il.bind("<Double-Button-1>",lambda e,res=res: self.after(10, lambda: self._apply_result(res)))
                        il.bind("<Button-3>",lambda e,res=res: (self._select_row(row,res), self._popup_result_menu(e,res)))
                    except Exception: pass
                self.after(0,_show)
            except Exception: pass
    def _select_row(self, frame, result):
        if self._selected_frame and self._selected_frame is not frame:
            self._selected_frame.config(bg=PANEL)
            for c in self._selected_frame.winfo_children():
                _set_bg(c, PANEL)
        self._selected_frame = frame
        self._selected_result = result
        frame.config(bg=BLUE)
        for c in frame.winfo_children():
            _set_bg(c, BLUE)
        self._apply_btn.config(state="normal" if self._target_iid else "disabled")

    def _popup_result_menu(self, event, result):
        self._selected_result = result
        try:
            self._result_menu.tk_popup(event.x_root, event.y_root)
        finally:
            self._result_menu.grab_release()

    def _apply_selected(self):
        if self._selected_result:
            self._apply_result(self._selected_result)
        else:
            self._status_lbl.config(text="Select a search result first (click a row).")

    def _apply_result(self, result):
        if not self._target_iid:
            self._status_lbl.config(
                text="⚠ Select a file in the scan list first (click row or right-click → Search & fix match)."
            )
            return
        result = normalize_search_result(dict(result))
        try:
            self._on_select(result, self._target_iid)
        except Exception as exc:
            self._status_lbl.config(text=f"Apply failed: {exc}")
            messagebox.showerror(
                "Apply failed", friendly_error(exc, context="apply"), parent=self.winfo_toplevel(),
            )
            return
        title = result.get("title") or result.get("name") or "?"
        self._status_lbl.config(text=f"✓ Applied: {title[:50]}")
        self._hint_lbl.config(text="Row updated — select another file or search again to fix more")
        self._refresh_target_banner()
        self._apply_btn.config(state="normal")
# ─────────────────────────────────────────────────────────────────────────────
#  MINI PICKER (uncertain match dialog) — with poster images
# ─────────────────────────────────────────────────────────────────────────────
class _MiniPicker(tk.Toplevel):
    def __init__(self,parent,api_key,title,results,filename,done_event):
        super().__init__(parent); self.chosen=None; self._done=done_event; self._rmap={}
        self._poster_imgs=[]; self._row_frames=[]; self._selected_frame=None
        self.configure(bg=BG); self.title("Uncertain match — please verify")
        self.geometry("780x540"); self.grab_set(); self.lift(); self.focus_force()
        self.protocol("WM_DELETE_WINDOW",self._skip)
        tk.Label(self,text=f"⚠ Low confidence match for: {filename}",
            font=("Segoe UI",11,"bold"),fg=GOLD,bg=BG).pack(fill="x",padx=14,pady=(10,2))
        tk.Label(self,text="Pick the correct title, or Skip to use TMDB's best guess.",
            font=FONT_SM,fg=DIM,bg=BG).pack(fill="x",padx=14)
        bar=tk.Frame(self,bg=BG); bar.pack(fill="x",padx=14,pady=6)
        self._qv=tk.StringVar(value=title)
        qe=tk.Entry(bar,textvariable=self._qv,font=FONT,bg=ENT_BG,fg=FG,
            insertbackground=FG,relief="flat",bd=4,width=36)
        qe.pack(side="left",padx=(0,6)); qe.bind("<Return>",lambda e: self._search(api_key))
        tk.Button(bar,text="Re-search",font=FONT,bg=ACCENT,fg="white",relief="flat",bd=0,
            padx=10,pady=3,command=lambda: self._search(api_key)).pack(side="left")
        # ── scrollable results panel ──────────────────────────────────────────
        outer=tk.Frame(self,bg=BG); outer.pack(fill="both",expand=True,padx=14,pady=4)
        self._canvas=tk.Canvas(outer,bg=PANEL,highlightthickness=0)
        vsb=ttk.Scrollbar(outer,orient="vertical",command=self._canvas.yview)
        self._canvas.configure(yscrollcommand=vsb.set)
        self._canvas.pack(side="left",fill="both",expand=True)
        vsb.pack(side="right",fill="y")
        self._inner=tk.Frame(self._canvas,bg=PANEL)
        self._inner_id=self._canvas.create_window((0,0),window=self._inner,anchor="nw")
        self._inner.bind("<Configure>",lambda e: self._canvas.configure(scrollregion=self._canvas.bbox("all")))
        self._canvas.bind("<Configure>",lambda e: self._canvas.itemconfig(self._inner_id,width=e.width))
        for ev in ("<MouseWheel>","<Button-4>","<Button-5>"):
            self._canvas.bind(ev,self._on_scroll)
        bot=tk.Frame(self,bg=BG); bot.pack(fill="x",padx=14,pady=8)
        tk.Button(bot,text="✅ Pick Selected",font=FONT,bg=GREEN,fg="white",relief="flat",bd=0,
            padx=12,pady=5,command=self._pick).pack(side="left")
        tk.Button(bot,text="Skip (best guess)",font=FONT,bg=ENT_BG,fg=FG,relief="flat",bd=0,
            padx=12,pady=5,command=self._skip).pack(side="left",padx=8)
        if results: self._populate(results)
    def _on_scroll(self,e):
        if e.num==4 or e.delta>0: self._canvas.yview_scroll(-1,"units")
        else: self._canvas.yview_scroll(1,"units")
    def _search(self,key):
        q=self._qv.get().strip()
        if not q: return
        def fetch():
            try:
                tmdb=TMDB(key)
                session = ui_search_start(tmdb, q, "Both", None)
                ranked = [normalize_search_result(dict(r)) for r in session.ranked()]
                self.after(0, lambda r=ranked[:SEARCH_UI_CHUNK]: self._populate(r))
            except Exception: pass
        threading.Thread(target=fetch,daemon=True).start()
    def _populate(self,results):
        for w in self._inner.winfo_children(): w.destroy()
        self._rmap.clear(); self._poster_imgs.clear()
        self._row_frames.clear(); self._selected_frame=None
        if not results:
            tk.Label(self._inner,text="No results found.",font=FONT,fg=DIM,bg=PANEL).pack(pady=20)
            return
        for r in results: self._build_row(r)
        # auto-select first
        if self._row_frames:
            self._select_row(self._row_frames[0][0], self._row_frames[0][1])
        threading.Thread(target=self._load_posters,args=(list(results),list(self._row_frames)),daemon=True).start()
    def _build_row(self,r):
        mt=r.get("media_type","movie"); title=r.get("title") or r.get("name") or "?"
        date=(r.get("release_date") or r.get("first_air_date") or "")[:4]
        ov=(r.get("overview") or "No overview.")[:140].replace("\n"," ")
        badge_col="#1a6b3c" if mt=="movie" else "#1a3a6b"
        label="Movie" if mt=="movie" else "TV Show"
        row=tk.Frame(self._inner,bg=PANEL,cursor="hand2"); row.pack(fill="x",padx=2,pady=1)
        # poster placeholder
        pframe=tk.Frame(row,bg="#2d333b",width=SEARCH_POSTER_W,height=SEARCH_POSTER_H)
        pframe.pack_propagate(False); pframe.pack(side="left",padx=(6,0),pady=4)
        plbl=tk.Label(pframe,bg="#2d333b",text="🎬",fg=DIM,font=("Segoe UI",16))
        plbl.place(relx=0.5,rely=0.5,anchor="center")
        info=tk.Frame(row,bg=PANEL); info.pack(side="left",fill="both",expand=True,padx=10,pady=4)
        tr=tk.Frame(info,bg=PANEL); tr.pack(fill="x")
        tk.Label(tr,text=title,font=("Segoe UI",10,"bold"),fg=FG,bg=PANEL,anchor="w").pack(side="left")
        if date: tk.Label(tr,text=f"  {date}",font=FONT_SM,fg=DIM,bg=PANEL).pack(side="left")
        tk.Label(tr,text=f" {label} ",font=("Segoe UI",8,"bold"),fg="white",bg=badge_col,padx=4,pady=1).pack(side="left",padx=6)
        tmdb_id=r.get("id")
        if tmdb_id: tk.Label(tr,text=f"ID: {tmdb_id}",font=("Segoe UI",8),fg="#58a6ff",bg=PANEL,padx=2).pack(side="left")
        tk.Label(info,text=ov,font=FONT_SM,fg=DIM,bg=PANEL,wraplength=560,justify="left",anchor="w").pack(fill="x")
        def _hon(e,f=row):
            if f is not self._selected_frame:
                f.config(bg="#1f2933")
                for c in f.winfo_children(): _set_bg(c,"#1f2933")
        def _hoff(e,f=row):
            col=BLUE if f is self._selected_frame else PANEL
            f.config(bg=col)
            for c in f.winfo_children(): _set_bg(c,col)
        def _click(e,f=row,res=r): self._select_row(f,res)
        def _dbl(e,res=r): self.chosen=res; self._close()
        for w in _all_widgets(row):
            w.bind("<Enter>",_hon); w.bind("<Leave>",_hoff)
            w.bind("<Button-1>",_click); w.bind("<Double-1>",_dbl)
        ttk.Separator(self._inner,orient="horizontal").pack(fill="x",padx=4)
        self._row_frames.append((row,r,plbl,pframe))
        self._rmap[id(row)]=r
    def _load_posters(self,results,frames):
        cache={}
        for r,(row,_r,plbl,pframe) in zip(results,frames):
            pp=r.get("poster_path")
            if not pp: continue
            try:
                if pp not in cache:
                    resp=requests.get(f"{TMDB_IMG_92}{pp}",timeout=8)
                    if resp.ok: cache[pp]=resp.content
                raw=cache.get(pp)
                if not raw: continue
                photo=bytes_to_photo(raw,SEARCH_POSTER_W,SEARCH_POSTER_H)
                if photo is None: continue
                self._poster_imgs.append(photo)
                def _show(plbl=plbl,pframe=pframe,photo=photo,row=row,res=r):
                    try:
                        plbl.place_forget()
                        il=tk.Label(pframe,image=photo,bg="#2d333b",cursor="hand2")
                        il.image=photo; il.place(relx=0,rely=0,relwidth=1,relheight=1)
                        il.bind("<Button-1>",lambda e,f=row,res=res: self._select_row(f,res))
                        il.bind("<Double-1>",lambda e,res=res: self._apply(res))
                    except Exception: pass
                self.after(0,_show)
            except Exception: pass
    def _apply(self,res): self.chosen=res; self._close()
    def _select_row(self,frame,result):
        if self._selected_frame and self._selected_frame is not frame:
            self._selected_frame.config(bg=PANEL)
            for c in self._selected_frame.winfo_children(): _set_bg(c,PANEL)
        self._selected_frame=frame; frame.config(bg=BLUE)
        for c in frame.winfo_children(): _set_bg(c,BLUE)
        # store as chosen so Pick Selected works
        self.chosen=result
    def _pick(self):
        if self.chosen: self._close()
    def _skip(self): self.chosen=None; self._close()
    def _close(self): self.grab_release(); self.destroy(); self._done.set()
# ─────────────────────────────────────────────────────────────────────────────
#  EPISODE BROWSER
# ─────────────────────────────────────────────────────────────────────────────
class EpisodeBrowser(tk.Toplevel):
    def __init__(self, parent, api_key: str, folder: str = "", dest_tv: str = ""):
        super().__init__(parent)
        self._api = api_key.strip()
        self._tmdb = TMDB(self._api) if self._api else None
        self._dest_tv = dest_tv.strip()
        self._show_id = None
        self._show_name = ""
        self._season_num = 1
        self._season_layout: list[tuple[int, int]] = []
        self._flat_remap_var = tk.BooleanVar(value=True)
        self._file_map: dict = {}
        self._ep_map: dict = {}
        self._selected_file = None
        self._rename_log: list[dict] = []
        self.configure(bg=BG)
        self.title("Episode Browser")
        self.geometry("1100x680")
        self.grab_set()
        self._build(folder)
    def _build(self, initial_folder):
        top = tk.Frame(self, bg=BG); top.pack(fill="x", padx=12, pady=(10,4))
        tk.Label(top, text="📁 Folder:", font=FONT, fg=FG, bg=BG).pack(side="left")
        self._folder_var = tk.StringVar(value=initial_folder)
        tk.Entry(top, textvariable=self._folder_var, font=FONT, bg=ENT_BG,
                 fg=FG, insertbackground=FG, relief="flat", bd=4, width=34
                 ).pack(side="left", padx=6)
        tk.Button(top, text="Browse…", font=FONT, bg=ENT_BG, fg=FG,
                  relief="flat", bd=0, padx=8, pady=3,
                  command=self._browse_folder).pack(side="left", padx=(0,4))
        tk.Button(top, text="Reload", font=FONT, bg=ENT_BG, fg=FG,
                  relief="flat", bd=0, padx=8, pady=3,
                  command=self._load_files).pack(side="left", padx=(0,14))
        tk.Label(top, text="🎬 Show:", font=FONT, fg=FG, bg=BG).pack(side="left")
        self._show_var = tk.StringVar()
        tk.Entry(top, textvariable=self._show_var, font=FONT, bg=ENT_BG,
                 fg=FG, insertbackground=FG, relief="flat", bd=4, width=28
                 ).pack(side="left", padx=6)
        tk.Button(top, text="Search TMDB", font=FONT, bg=ACCENT, fg="white",
                  relief="flat", bd=0, padx=10, pady=3,
                  command=self._search_show).pack(side="left", padx=(0,6))
        self._status = tk.Label(top, text="Pick a folder to begin.",
                                font=FONT_SM, fg=DIM, bg=BG)
        self._status.pack(side="left", padx=10)
        ttk.Separator(self, orient="horizontal").pack(fill="x", padx=6)
        sbar = tk.Frame(self, bg=BG); sbar.pack(fill="x", padx=12, pady=4)
        tk.Label(sbar, text="Season:", font=FONT, fg=FG, bg=BG).pack(side="left")
        self._season_var = tk.StringVar(value="1")
        self._season_cb  = ttk.Combobox(sbar, textvariable=self._season_var,
                                        values=[], width=6, state="readonly", font=FONT)
        self._season_cb.pack(side="left", padx=6)
        self._season_cb.bind("<<ComboboxSelected>>", lambda e: self._load_season())
        tk.Checkbutton(
            sbar,
            text="Site uses one season → remap to TMDB",
            variable=self._flat_remap_var,
            font=FONT_SM,
            fg=FG,
            bg=BG,
            activebackground=BG,
            activeforeground=FG,
            selectcolor=PANEL,
        ).pack(side="left", padx=(12, 0))
        tk.Button(sbar, text="⚡ Remap & Rename All", font=FONT, bg=GREEN,
                  fg="white", relief="flat", bd=0, padx=12, pady=4,
                  command=self._rename_all_in_order).pack(side="right")
        tk.Button(sbar, text="↩ Undo Last Rename", font=FONT, bg=ENT_BG,
                  fg=DIM, relief="flat", bd=0, padx=10, pady=4,
                  command=self._undo_last).pack(side="right", padx=6)
        pane = tk.PanedWindow(self, orient="horizontal", bg=BG,
                              sashwidth=6, relief="flat")
        pane.pack(fill="both", expand=True, padx=6, pady=4)
        lf = tk.Frame(pane, bg=BG); pane.add(lf, minsize=340, width=400)
        tk.Label(lf, text="Local Files  (click to select)", font=FONT_SM,
                 fg=DIM, bg=BG).pack(anchor="w", padx=4)
        style = ttk.Style()
        style.configure("Ep.Treeview", background=PANEL, foreground=FG,
                        fieldbackground=PANEL, rowheight=26, font=FONT_SM)
        style.configure("Ep.Treeview.Heading", background="#21262d",
                        foreground=FG, font=("Segoe UI",9,"bold"), relief="flat")
        style.map("Ep.Treeview", background=[("selected", BLUE)],
                  foreground=[("selected","white")])
        self._file_tree = ttk.Treeview(lf, columns=("name","status"),
                                       show="headings", style="Ep.Treeview",
                                       selectmode="browse")
        self._file_tree.heading("name",   text="Filename")
        self._file_tree.heading("status", text="Status")
        self._file_tree.column("name",   width=290, anchor="w")
        self._file_tree.column("status", width=80,  anchor="center", stretch=False)
        fsb = ttk.Scrollbar(lf, orient="vertical", command=self._file_tree.yview)
        self._file_tree.configure(yscrollcommand=fsb.set)
        self._file_tree.pack(side="left", fill="both", expand=True)
        fsb.pack(side="right", fill="y")
        self._file_tree.tag_configure("done",    foreground="#3fb950")
        self._file_tree.tag_configure("pending", foreground=FG)
        self._file_tree.bind("<<TreeviewSelect>>", self._on_file_select)
        rf = tk.Frame(pane, bg=BG); pane.add(rf, minsize=340)
        tk.Label(rf, text="TMDB Episodes  (double-click to rename selected file)",
                 font=FONT_SM, fg=DIM, bg=BG).pack(anchor="w", padx=4)
        self._ep_tree = ttk.Treeview(rf, columns=("ep","name","air"),
                                     show="headings", style="Ep.Treeview",
                                     selectmode="browse")
        self._ep_tree.heading("ep",   text="Ep")
        self._ep_tree.heading("name", text="Episode Title")
        self._ep_tree.heading("air",  text="Air Date")
        self._ep_tree.column("ep",   width=42,  anchor="center", stretch=False)
        self._ep_tree.column("name", width=330, anchor="w")
        self._ep_tree.column("air",  width=90,  anchor="center", stretch=False)
        esb = ttk.Scrollbar(rf, orient="vertical", command=self._ep_tree.yview)
        self._ep_tree.configure(yscrollcommand=esb.set)
        self._ep_tree.pack(side="left", fill="both", expand=True)
        esb.pack(side="right", fill="y")
        self._ep_tree.bind("<Double-1>", self._on_ep_double_click)
        bot = tk.Frame(self, bg=ENT_BG); bot.pack(fill="x", side="bottom")
        self._bot_lbl = tk.Label(bot, text="Ready.", font=FONT_SM,
                                  fg=FG, bg=ENT_BG, anchor="w", padx=10, pady=4)
        self._bot_lbl.pack(fill="x")
        dest_hint = f"  → TV library: {self._dest_tv}" if self._dest_tv else "  → renames in place (set TV Shows folder in main window)"
        self._bot_lbl.config(text=f"Ready.{dest_hint}")
        if initial_folder and os.path.isdir(initial_folder):
            self._folder_var.set(initial_folder)
            guess = os.path.basename(initial_folder.rstrip("\\/"))
            if guess.lower().startswith("season "):
                guess = os.path.basename(os.path.dirname(initial_folder.rstrip("\\/")))
            self._show_var.set(guess)
            self._load_files()
            if self._api and guess:
                self.after(400, self._search_show)

    def _browse_folder(self):
        p = filedialog.askdirectory(title="Select folder with episode files")
        if p:
            self._folder_var.set(p)
            guess = os.path.basename(p.rstrip("\\/"))
            if guess.lower().startswith("season "):
                guess = os.path.basename(os.path.dirname(p.rstrip("\\/")))
            if not self._show_var.get().strip():
                self._show_var.set(guess)
            self._load_files()

    def _load_files(self):
        folder = self._folder_var.get().strip()
        self._file_tree.delete(*self._file_tree.get_children())
        self._file_map.clear()
        self._selected_file = None
        if not folder or not os.path.isdir(folder):
            self._status.config(text="Select a valid folder.")
            return
        names = sorted(
            [f for f in os.listdir(folder) if os.path.splitext(f)[1].lower() in VIDEO_EXT],
            key=natural_sort_key,
        )
        for fname in names:
            path = os.path.join(folder, fname)
            iid = self._file_tree.insert("", "end", values=(fname, "Pending"), tags=("pending",))
            self._file_map[iid] = {"iid": iid, "path": path, "name": fname, "status": "pending"}
        n = len(names)
        self._status.config(text=f"{n} video file(s) in folder.")
        self._bot_lbl.config(
            text=f"{n} file(s) loaded — search show, pick season, then map episodes."
        )
        if self._show_id and self._season_layout and self._detect_flat_season_download():
            self._flat_remap_var.set(True)

    def _search_show(self):
        if not self._api or not self._tmdb:
            messagebox.showwarning(
                "API Key Missing",
                "Enter your TMDB API key in the main window first.",
            )
            return
        title = self._show_var.get().strip()
        if not title:
            messagebox.showinfo("Title required", "Enter a show name to search.")
            return
        self._status.config(text="Searching TMDB…")
        threading.Thread(target=self._fetch_show, args=(title,), daemon=True).start()

    def _fetch_show(self, title: str):
        try:
            results = search_tv_with_fallback(self._tmdb, title, None)
            if not results:
                self.after(0, lambda: self._status.config(text=f"No results for {title!r}."))
                return
            ask, best, _ = auto_pick_tv(self._tmdb, title, None)
            chosen = best
            if ask:
                done = threading.Event()
                holder: dict = {}

                def open_picker():
                    holder["dlg"] = _MiniPicker(
                        self,
                        self._api,
                        title,
                        [dict(r, media_type="tv") for r in results],
                        "show lookup",
                        done,
                    )

                self.after(0, open_picker)
                done.wait()
                dlg = holder.get("dlg")
                if dlg is None:
                    return
                if dlg.chosen is None:
                    self.after(0, lambda: self._status.config(text="Show search cancelled."))
                    return
                chosen = dlg.chosen
            if not chosen:
                self.after(0, lambda: self._status.config(text="No show selected."))
                return
            self.after(0, lambda: self._apply_show(chosen))
        except Exception as exc:
            msg = friendly_error(exc, context="show search")
            self.after(0, lambda m=msg: self._status.config(text=m))

    def _apply_show(self, show: dict):
        self._show_id = show["id"]
        self._show_name = sanitize(show.get("name") or show.get("title") or "Unknown Show")
        self._show_var.set(self._show_name)
        self._season_layout = tmdb_season_layout(self._tmdb, self._show_id) if self._tmdb else []
        if self._detect_flat_season_download():
            self._flat_remap_var.set(True)
        details = self._tmdb.tv_details(self._show_id) if self._tmdb else {}
        season_vals: list[str] = []
        if details.get("seasons"):
            for s in details["seasons"]:
                sn = s.get("season_number")
                if sn is not None and str(sn) not in season_vals:
                    season_vals.append(str(sn))
        if not season_vals:
            n = max(1, int(details.get("number_of_seasons") or 1))
            season_vals = [str(i) for i in range(1, n + 1)]
        season_vals.sort(key=lambda x: int(x))
        self._season_cb["values"] = season_vals
        detected = self._detect_season_from_files()
        pick = str(detected) if str(detected) in season_vals else season_vals[0]
        self._season_var.set(pick)
        layout_hint = ""
        if self._season_layout:
            parts = [f"S{sn}:{cnt}" for sn, cnt in self._season_layout]
            layout_hint = "  •  " + " ".join(parts)
        self._status.config(
            text=f"Show: {self._show_name}  •  {len(season_vals)} season(s){layout_hint}"
        )
        self._load_season()

    def _file_download_episode(self, finfo: dict) -> int:
        parsed = parse_tv_episode_from_name(finfo["name"])
        if parsed:
            return parsed[1]
        _, _, hint = parse_stem(os.path.splitext(finfo["name"])[0])
        if isinstance(hint, tuple) and hint[0] == "tv":
            return hint[2]
        return 0

    def _detect_flat_season_download(self) -> bool:
        hints: list[tuple[int, int]] = []
        for info in self._file_map.values():
            parsed = parse_tv_episode_from_name(info["name"])
            if parsed:
                hints.append(parsed)
            else:
                _, _, h = parse_stem(os.path.splitext(info["name"])[0])
                if isinstance(h, tuple) and h[0] == "tv":
                    hints.append((h[1], h[2]))
        if not hints or not self._season_layout:
            return False
        seasons = {s for s, _ in hints}
        max_ep = max(e for _, e in hints)
        s1_eps = next((c for sn, c in self._season_layout if sn == 1), 0)
        return seasons == {1} and max_ep > s1_eps

    def _detect_season_from_files(self) -> int:
        counts: dict[int, int] = {}
        for info in self._file_map.values():
            stem = os.path.splitext(info["name"])[0]
            _, _, hint = parse_stem(stem)
            if isinstance(hint, tuple) and hint[0] == "tv":
                counts[hint[1]] = counts.get(hint[1], 0) + 1
        if counts:
            return max(counts, key=counts.get)
        try:
            return int(self._season_var.get())
        except ValueError:
            return 1

    def _load_season(self):
        if not self._show_id:
            messagebox.showinfo("No show", "Search for a TV show first.")
            return
        if not self._tmdb:
            return
        try:
            season = int(self._season_var.get())
        except ValueError:
            season = 1
        self._season_num = season
        self._status.config(text=f"Loading season {season}…")
        threading.Thread(target=self._fetch_season, args=(season,), daemon=True).start()

    def _fetch_season(self, season: int):
        try:
            eps = self._tmdb.season(self._show_id, season)
            self.after(0, lambda: self._populate_episodes(season, eps))
        except Exception as exc:
            msg = friendly_error(exc, context="season")
            self.after(0, lambda m=msg: self._status.config(text=m))

    def _populate_episodes(self, season: int, eps: list):
        self._ep_tree.delete(*self._ep_tree.get_children())
        self._ep_map.clear()
        self._season_num = season
        for ep in sorted(eps, key=lambda e: e.get("episode_number", 0)):
            num = ep.get("episode_number", 0)
            name = ep.get("name") or f"Episode {num}"
            air = (ep.get("air_date") or "")[:10]
            iid = self._ep_tree.insert("", "end", values=(f"{num:02d}", name, air))
            self._ep_map[iid] = ep
        pending = len(self._pending_files())
        self._status.config(text=f"Season {season}: {len(eps)} episode(s) from TMDB")
        self._bot_lbl.config(
            text=f"{pending} pending file(s)  •  select file, double-click episode to rename"
        )

    def _pending_files(self) -> list[dict]:
        return [f for f in self._file_map.values() if f.get("status") == "pending"]

    def _on_file_select(self, _=None):
        sel = self._file_tree.selection()
        if not sel:
            self._selected_file = None
            return
        self._selected_file = self._file_map.get(sel[0])
        if self._selected_file:
            self._bot_lbl.config(text=f"Selected: {self._selected_file['name']}")

    def _update_file_row(self, file_info: dict, status_text: str):
        tag = "done" if file_info.get("status") == "done" else "pending"
        self._file_tree.item(
            file_info["iid"],
            values=(file_info["name"], status_text),
            tags=(tag,),
        )

    def _target_path(self, src_folder: str, new_name: str, season: int) -> str:
        if self._dest_tv and os.path.isdir(self._dest_tv):
            return build_tv_path(self._dest_tv, self._show_name, season, new_name)
        return os.path.join(src_folder, new_name)

    def _rename_one(
        self,
        file_info: dict,
        ep_data: dict,
        *,
        show_message: bool = True,
        season_override: int | None = None,
    ) -> bool:
        if not self._show_name or not self._show_id:
            messagebox.showwarning("No show", "Search for a TV show first.")
            return False
        season = season_override if season_override is not None else self._season_num
        ep_num = ep_data.get("episode_number", 0)
        old_path = file_info["path"]
        if not os.path.isfile(old_path):
            messagebox.showerror("Missing file", f"File not found:\n{old_path}")
            return False
        ext = os.path.splitext(old_path)[1]
        new_name = build_tv_episode_filename(
            self._show_name, season, ep_num, ep_data.get("name"), ext
        )
        src_folder = os.path.dirname(old_path)
        new_path = self._target_path(src_folder, new_name, season)
        if os.path.normcase(old_path) == os.path.normcase(new_path):
            file_info["status"] = "done"
            self._update_file_row(file_info, "OK")
            return True
        if os.path.exists(new_path):
            messagebox.showerror("Exists", f"Target already exists:\n{new_path}")
            return False
        try:
            os.makedirs(os.path.dirname(new_path) or ".", exist_ok=True)
            shutil.move(old_path, new_path)
            self._rename_log.append({"old_path": old_path, "new_path": new_path})
            file_info["path"] = new_path
            file_info["name"] = os.path.basename(new_path)
            file_info["status"] = "done"
            self._update_file_row(file_info, "Done")
            if show_message:
                self._bot_lbl.config(text=f"Renamed → {file_info['name']}")
            return True
        except Exception as exc:
            messagebox.showerror("Rename failed", friendly_error(exc, context="rename"))
            return False

    def _on_ep_double_click(self, _=None):
        if not self._selected_file:
            messagebox.showinfo("Select a file", "Select a local file on the left first.")
            return
        sel = self._ep_tree.selection()
        if not sel:
            return
        ep = self._ep_map.get(sel[0])
        if ep and self._rename_one(self._selected_file, ep):
            append_history([self._rename_log[-1]])

    def _rename_all_in_order(self):
        if not self._show_id:
            messagebox.showwarning("No show", "Search for a TV show first.")
            return
        pending = self._pending_files()
        if not pending:
            messagebox.showinfo("Nothing to do", "No pending files to rename.")
            return
        if self._flat_remap_var.get() and self._season_layout:
            self._rename_all_flat_remap(pending)
            return
        eps_sorted = sorted(self._ep_map.values(), key=lambda e: e.get("episode_number", 0))
        if not eps_sorted:
            messagebox.showinfo("No episodes", "Load a season with TMDB episodes first.")
            return
        n = min(len(pending), len(eps_sorted))
        if len(pending) != len(eps_sorted):
            if not messagebox.askyesno(
                "Count mismatch",
                f"{len(pending)} pending file(s), {len(eps_sorted)} episode(s).\n"
                f"Rename the first {n} in sorted order?",
            ):
                return
        if not messagebox.askyesno("Confirm", f"Rename {n} file(s) to episodes 1–{n} in order?"):
            return
        batch: list[dict] = []
        ok = 0
        for finfo, ep in zip(pending[:n], eps_sorted[:n]):
            if self._rename_one(finfo, ep, show_message=False):
                ok += 1
                batch.append(self._rename_log[-1])
        if batch:
            append_history(batch)
        self._bot_lbl.config(text=f"Batch done — {ok}/{n} renamed.")
        messagebox.showinfo("Rename complete", f"Successfully renamed {ok} of {n} file(s).")

    def _rename_all_flat_remap(self, pending: list[dict]):
        if not self._tmdb:
            return
        total_eps = sum(c for _, c in self._season_layout)
        layout_txt = ", ".join(f"S{sn}×{cnt}" for sn, cnt in self._season_layout)
        if not messagebox.askyesno(
            "Remap all seasons",
            f"Rename {len(pending)} file(s) using TMDB season layout:\n{layout_txt}\n\n"
            f"Download episode numbers (e.g. S01E19) map to absolute episode 19 "
            f"→ correct TMDB season/episode across {len(self._season_layout)} season(s).\n\n"
            f"Continue?",
        ):
            return
        pending_sorted = sorted(pending, key=lambda f: self._file_download_episode(f))
        batch: list[dict] = []
        ok = 0
        skipped = 0
        for finfo in pending_sorted:
            abs_ep = self._file_download_episode(finfo)
            mapped = absolute_episode_to_season_episode(abs_ep, self._season_layout)
            if not mapped:
                skipped += 1
                continue
            season, ep_num = mapped
            ep_data = self._tmdb.episode(self._show_id, season, ep_num) or {
                "episode_number": ep_num,
                "name": None,
            }
            if self._rename_one(
                finfo, ep_data, show_message=False, season_override=season,
            ):
                ok += 1
                batch.append(self._rename_log[-1])
        if batch:
            append_history(batch)
        msg = f"Successfully renamed {ok} of {len(pending)} file(s)."
        if skipped:
            msg += f"\n{skipped} skipped (episode beyond TMDB total {total_eps})."
        self._bot_lbl.config(text=f"Flat remap done — {ok}/{len(pending)} renamed.")
        messagebox.showinfo("Rename complete", msg)

    def _undo_last(self):
        if not self._rename_log:
            messagebox.showinfo("Nothing to undo", "No renames in this session yet.")
            return
        entry = self._rename_log.pop()
        old_path, new_path = entry["old_path"], entry["new_path"]
        try:
            if not os.path.exists(new_path):
                raise FileNotFoundError(os.path.basename(new_path))
            if os.path.exists(old_path):
                raise FileExistsError(os.path.basename(old_path))
            os.makedirs(os.path.dirname(old_path) or ".", exist_ok=True)
            shutil.move(new_path, old_path)
            for info in self._file_map.values():
                if os.path.normcase(info.get("path", "")) == os.path.normcase(new_path):
                    info["path"] = old_path
                    info["name"] = os.path.basename(old_path)
                    info["status"] = "pending"
                    self._update_file_row(info, "Pending")
                    break
            self._bot_lbl.config(text=f"Undone: {os.path.basename(old_path)}")
            _toast(self, "Last rename undone.", color=BLUE, duration=2500)
        except Exception as exc:
            self._rename_log.append(entry)
            messagebox.showerror("Undo failed", friendly_error(exc, context="undo"))

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
class MediaRenamer(tk.Tk):
    def __init__(self):
        super().__init__(); self.title("Media Renamer for Jellyfin")
        self.geometry("1180x1020"); self.configure(bg=BG); self.resizable(True,True)
        self.renames: dict[str, RenameRow] = {}
        self._main_poster_imgs={}
        self._genres = GenreCache()
        self._scan_cancel = threading.Event()
        self._pending_manual = 0
        self._manual_completed = 0
        self._manual_finished: set[str] = set()
        self._genre_folder_map = {}  # maps TMDB genre name (lowercase) → full folder path
        self._id_cache = load_id_cache()
        self._id_cache_lock = threading.Lock()
        self._picker_active = False
        self._cfg_save_after_id = None
        self._cache_save_after_id = None
        self.api_var=tk.StringVar(); self.folder_var=tk.StringVar()
        self.server_var=tk.StringVar()
        self.dest_movies_var=tk.StringVar(); self.dest_tv_var=tk.StringVar()
        self.dest_other_var=tk.StringVar()
        self._server_movies_root = ""
        self._server_tv_root = ""
        self.copy_to_genres_var = tk.BooleanVar(value=True)
        self.dry_run_var = tk.BooleanVar(value=True)
        self.slow_mode_var = tk.BooleanVar(value=False)
        self.flat_season_remap_var = tk.BooleanVar(value=True)
        self.conflict_var = tk.StringVar(value=CONFLICT_POLICIES[0])
        self.jellyfin_url_var = tk.StringVar()
        self.jellyfin_key_var = tk.StringVar()
        self.jellyfin_auto_scan_var = tk.BooleanVar(value=True)
        self._unmatched_export: list[dict] = []
        self._jellyfin_resolved = ""
        self._api_wizard_shown = False
        self._load_cfg(); self._build_ui(); self._set_icon()
        self._update_apply_button()
        for v in (
            self.api_var, self.folder_var, self.server_var,
            self.dest_movies_var, self.dest_tv_var, self.dest_other_var,
            self.jellyfin_url_var, self.jellyfin_key_var,
        ):
            v.trace_add("write", self._schedule_save_cfg)
        self.api_var.trace_add("write", lambda *_: self.after(150, self._refresh_api_key_banner))
        self.jellyfin_auto_scan_var.trace_add("write", self._schedule_save_cfg)
        self.flat_season_remap_var.trace_add("write", self._schedule_save_cfg)
        self.server_var.trace_add("write", lambda *_: self.after(300, self._scan_media_folders))
        self.dest_movies_var.trace_add("write", lambda *_: self.after(300, self._scan_media_folders))
        self.after(500, self._scan_media_folders)
        self.protocol("WM_DELETE_WINDOW",self._on_close)
        self._picker_q = queue.Queue()
        self._manual_seq = 0
        self._scan_lock = threading.Lock()
        self._picker_timeout_after_id: str | None = None
        self._api_banner: tk.Frame | None = None
        self.after(200, self._poll_picker_q)
        self.after(400, self._maybe_show_api_onboarding)
    def _set_icon(self):
        self._icon_photo = None
        try:
            icon_path = ensure_app_icon()
            if icon_path:
                self.iconbitmap(default=icon_path)
                if PIL_OK:
                    im = Image.open(icon_path)
                    im = im.resize((64, 64), Image.Resampling.LANCZOS)
                    self._icon_photo = ImageTk.PhotoImage(im)
                    self.iconphoto(True, self._icon_photo)
                return
        except (tk.TclError, OSError) as e:
            log_line(f"app icon load failed: {e}")
        try:
            self._icon_photo = tk.PhotoImage(data=ICON_B64)
            self.iconphoto(True, self._icon_photo)
        except tk.TclError:
            pass
    def _load_cfg(self):
        c=load_config()
        self.api_var.set(c.get("api_key",""))
        self.folder_var.set(c.get("source_folder",""))
        self.server_var.set(c.get("server",""))
        if not self.server_var.get() and c.get("dest_movies"):
            self.server_var.set(c.get("dest_movies",""))
        self.dest_movies_var.set(c.get("dest_movies",""))
        self.dest_tv_var.set(c.get("dest_tv",""))
        self.dest_other_var.set(c.get("dest_other",""))
        if "copy_to_genres" in c:
            self.copy_to_genres_var.set(bool(c.get("copy_to_genres", True)))
        if "dry_run" in c:
            self.dry_run_var.set(bool(c.get("dry_run", True)))
        if "slow_mode" in c:
            self.slow_mode_var.set(bool(c.get("slow_mode", False)))
        if "flat_season_remap" in c:
            self.flat_season_remap_var.set(bool(c.get("flat_season_remap", True)))
        if c.get("conflict_policy") in CONFLICT_POLICIES:
            self.conflict_var.set(c["conflict_policy"])
        self.jellyfin_url_var.set(c.get("jellyfin_url", ""))
        self.jellyfin_key_var.set(c.get("jellyfin_api_key", ""))
        self._jellyfin_resolved = c.get("jellyfin_resolved_url", "")
        if "jellyfin_auto_scan" in c:
            self.jellyfin_auto_scan_var.set(bool(c.get("jellyfin_auto_scan", True)))
    def _schedule_save_cfg(self, *_):
        if self._cfg_save_after_id is not None:
            self.after_cancel(self._cfg_save_after_id)
        self._cfg_save_after_id = self.after(CONFIG_SAVE_DEBOUNCE_MS, self._flush_save_cfg)

    def _flush_save_cfg(self):
        self._cfg_save_after_id = None
        self._save_cfg()

    def _cache_apply_update(self, cache_update: tuple[str, dict] | None) -> None:
        if not cache_update:
            return
        path_key, value = cache_update
        with self._id_cache_lock:
            id_cache_set(self._id_cache, path_key, value)

    def _schedule_cache_save(self) -> None:
        if self._cache_save_after_id is not None:
            self.after_cancel(self._cache_save_after_id)
        self._cache_save_after_id = self.after(800, self._flush_cache_save)

    def _flush_cache_save(self) -> None:
        self._cache_save_after_id = None
        with self._id_cache_lock:
            save_id_cache(self._id_cache)

    def _save_cfg(self):
        save_config({
            "api_key": self.api_var.get(),
            "source_folder": self.folder_var.get(),
            "server": self.server_var.get(),
            "dest_movies": self.dest_movies_var.get(),
            "dest_tv": self.dest_tv_var.get(),
            "dest_other": self.dest_other_var.get(),
            "copy_to_genres": self.copy_to_genres_var.get(),
            "dry_run": self.dry_run_var.get(),
            "slow_mode": self.slow_mode_var.get(),
            "flat_season_remap": self.flat_season_remap_var.get(),
            "conflict_policy": self.conflict_var.get(),
            "jellyfin_url": self.jellyfin_url_var.get(),
            "jellyfin_api_key": self.jellyfin_key_var.get(),
            "jellyfin_resolved_url": getattr(self, "_jellyfin_resolved", ""),
            "jellyfin_auto_scan": self.jellyfin_auto_scan_var.get(),
        })
    def _on_close(self):
        self._scan_cancel.set()
        if self._cfg_save_after_id is not None:
            self.after_cancel(self._cfg_save_after_id)
            self._cfg_save_after_id = None
        self._save_cfg()
        if self._cache_save_after_id is not None:
            self.after_cancel(self._cache_save_after_id)
            self._cache_save_after_id = None
        with self._id_cache_lock:
            save_id_cache(self._id_cache)
        self.destroy()
