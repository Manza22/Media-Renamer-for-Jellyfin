    def _browse(self):
        p=filedialog.askdirectory(title="Select Media Folder")
        if p: self.folder_var.set(p)
    def _browse_server(self):
        p = filedialog.askdirectory(
            title="Select Server — your media library root (genre folders inside)",
        )
        if p:
            self.server_var.set(p)
            self._scan_media_folders()
    def _browse_dest(self,var):
        p=filedialog.askdirectory(title="Select Destination Folder")
        if p: var.set(p)
    def _get_movies_inbox(self) -> str:
        return (
            self.dest_movies_var.get().strip()
            or self._server_movies_root
            or self.server_var.get().strip()
        )
    def _plan_file_op(self, old_path: str, new_path: str, type_str: str, genre_ids: list) -> str:
        """Return 'copy', 'move', or 'skip' for a planned path change."""
        if os.path.normcase(old_path) == os.path.normcase(new_path):
            return "skip"
        movies_inbox = self._get_movies_inbox()
        stem = os.path.splitext(os.path.basename(old_path))[0]
        title, _, _ = parse_stem(stem)
        genre_dir = genre_folder_for_ids(
            genre_ids, self._genre_folder_map, title=title, genres=self._genres,
        )
        if (
            self.copy_to_genres_var.get()
            and type_str == "Movie"
            and genre_dir
            and movies_inbox
            and path_under_dir(old_path, movies_inbox)
            and path_under_dir(new_path, genre_dir)
        ):
            return "copy"
        return "move"
    def _fix_server_folder_names(self):
        server = self.server_var.get().strip()
        if not server or not os.path.isdir(server):
            messagebox.showwarning(
                "Server path missing",
                "Set your Server path to the media library root (e.g. \\\\192.168.0.39\\Media), then try again.",
            )
            return
        planned = plan_folder_renames(server)
        if not planned:
            messagebox.showinfo(
                "Folder names OK",
                "No typo genre folders found to rename.\n\n"
                "Known fixes: Acion → Action, scifi → Sci-Fi, etc.",
            )
            return
        lines = "\n".join(f"  {os.path.basename(a)}  →  {os.path.basename(b)}" for a, b in planned)
        if not messagebox.askyesno(
            "Fix folder names on server",
            f"Rename {len(planned)} folder(s) on the server?\n\n{lines}\n\n"
            "Only empty or existing typo names are changed. Files inside are kept.",
        ):
            return
        ok, errors = apply_folder_renames(planned)
        self._scan_media_folders()
        if errors:
            messagebox.showwarning(
                "Some renames failed",
                f"Renamed {ok} folder(s).\n\n" + "\n".join(errors[:10]),
            )
        else:
            messagebox.showinfo("Done", f"Renamed {ok} genre folder(s). Rescan or copy movies again.")
            _toast(self, f"✓ Renamed {ok} folder(s)", color=GREEN)

    def _scan_movies_to_genres(self):
        key = self.api_var.get().strip()
        if not key:
            messagebox.showwarning("API Key Missing", "Enter your TMDB API key.")
            return
        self._scan_media_folders()
        movies_dir = self._get_movies_inbox()
        if not movies_dir or not os.path.isdir(movies_dir):
            messagebox.showwarning(
                "Movies Folder Missing",
                "Set Server (or Movies Folder) to the folder where your movies are stored.",
            )
            return
        if not self._genre_folder_map:
            messagebox.showwarning(
                "No Genre Folders",
                "No genre subfolders found on your Server.\n\n"
                "Create folders like Sci-Fi, Romance, Action next to (or inside) Movies, then browse Server again.",
            )
            return
        self.copy_to_genres_var.set(True)
        if not self._begin_scan():
            _toast(self, "A scan is already running — wait for it to finish.", color=GOLD, duration=3500)
            return
        self._clear()
        self.status_var.set(f"Scanning movies in {movies_dir}…")
        threading.Thread(
            target=self._run_scan_movies_to_genres,
            args=(key, movies_dir),
            daemon=True,
        ).start()
    def _run_scan_movies_to_genres(self, key: str, movies_dir: str):
        try:
            self._do_scan_movies_to_genres(key, movies_dir)
        finally:
            self.after(0, self._end_scan)
    def _apply_genre_movie_outcome(
        self, out: FileMatchOutcome, old_path: str, title: str, result: dict | None,
    ) -> FileMatchOutcome:
        """Route a movie match into a genre subfolder (Copy Movies → Genres scan)."""
        if not out.new_name or out.new_name == out.fname:
            return out
        route_title = sanitize(result.get("title") or result.get("name") or title) if result else title
        genre_dir = genre_folder_for_ids(
            out.genre_ids, self._genre_folder_map, title=route_title, genres=self._genres,
        )
        if not genre_dir:
            out.status = "No genre folder"
            out.tag = "no_match"
            out.new_path = old_path
            out.op = "skip"
            return out
        out.new_path = os.path.join(genre_dir, out.new_name)
        out.op = self._plan_file_op(old_path, out.new_path, out.type_str, out.genre_ids)
        if out.op == "copy":
            out.status = f"Copy → {os.path.basename(genre_dir)}"
            out.tag = "matched"
            if os.path.exists(out.new_path):
                out.status = f"Exists in {os.path.basename(genre_dir)}"
                out.tag = "no_match"
                out.op = "skip"
        else:
            out.status = "Matched"
            out.tag = "matched"
        return out

    def _do_scan_movies_to_genres(self, key: str, movies_dir: str):
        self._genres.load(key)
        tmdb = self._tmdb(key)
        services = self._scan_services()
        files = list(iter_movies_inbox_files(movies_dir, self._genre_folder_map))
        total = len(files)
        if not total:
            self.after(0, lambda: self.status_var.set("No video files found in Movies folder."))
            return
        matched = copy_n = no_genre = 0
        for i, old_path in enumerate(files, 1):
            if self._scan_cancel.is_set():
                break
            fname = os.path.basename(old_path)
            folder = os.path.dirname(old_path) or movies_dir
            pct = (i / total) * 100
            self.after(0, self._progress_var.set, pct)
            self.after(0, self.status_var.set, f"Movies {i}/{total}: {fname}")
            title, year, type_hint = parse_stem(os.path.splitext(fname)[0])
            if isinstance(type_hint, tuple) and type_hint[0] == "tv":
                continue
            outcome = resolve_file_match(
                tmdb, self._genres, fname, folder, self._id_cache, services,
                cancel_event=self._scan_cancel,
            )
            if outcome.status == "Cancelled":
                break
            if outcome.cache_update:
                self._cache_apply_update(outcome.cache_update)
            if outcome.manual_job:
                outcome.manual_job.api_key = key
                outcome.manual_job.mode = "genre"
                outcome.manual_job.movies_dir = movies_dir
                self.after(0, lambda o=outcome, op=old_path: self._queue_manual_pick(o, old_path))
                continue
            if outcome.api_error:
                self.after(0, lambda msg=outcome.api_error: _toast(
                    self, msg[:80] if msg else "TMDB error", color=ACCENT, duration=5000,
                ))
            if not outcome.matched:
                self.after(0, lambda o=outcome: self._apply_outcome_row(o))
                continue
            out = self._apply_genre_movie_outcome(outcome, old_path, title, outcome.result)
            if out.status == "No genre folder":
                no_genre += 1
            elif out.op == "copy" and out.tag == "matched":
                copy_n += 1
                matched += 1
            elif out.tag == "matched":
                matched += 1
            self.after(0, lambda o=out: self._apply_outcome_row(o))
        self._schedule_cache_save()
        self.after(0, self._progress_var.set, 100)
        summary = f"Movies: {matched} matched, {copy_n} ready to copy"
        if no_genre:
            summary += f", {no_genre} without a genre folder"
        if self._pending_manual:
            summary += f"  •  {self._pending_manual} awaiting picker"
        summary += "  •  Click Apply to copy (originals stay in Movies)."
        self.after(0, lambda s=summary: self.status_var.set(s))
    def _scan_services(self) -> ScanServices:
        return ScanServices(
            resolve_dest=self._resolve_dest,
            plan_file_op=self._plan_file_op,
            genre_folder_map=self._genre_folder_map,
            copy_to_genres=self.copy_to_genres_var.get(),
            flat_season_remap=self.flat_season_remap_var.get(),
        )

    def _scan_row_display_name(self, iid: str) -> str:
        row = self.renames.get(iid)
        if row:
            return os.path.basename(row.old_path)
        vals = self.tree.item(iid, "values")
        return vals[1] if vals and len(vals) > 1 else ""

    def _bind_row_to_search(self, iid: str, run_search: bool = True):
        vals = self.tree.item(iid, "values")
        if not vals:
            return
        title, _, _ = parse_stem(os.path.splitext(vals[1])[0])
        self._search_panel.load_row(iid, title)
        if run_search:
            self._search_panel._do_search()

    def _on_row_click(self, _=None):
        sel = self.tree.selection()
        if not sel:
            return
        self._bind_row_to_search(sel[0], run_search=True)

    def _on_row_double_click(self, event=None):
        iid = self.tree.identify_row(event.y) if event else None
        if not iid:
            sel = self.tree.selection()
            iid = sel[0] if sel else None
        if not iid:
            return
        self.tree.selection_set(iid)
        self._bind_row_to_search(iid, run_search=False)
        self._search_panel._entry.focus_set()

    def _tree_context_menu(self, event):
        iid = self.tree.identify_row(event.y)
        if not iid:
            return
        self.tree.selection_set(iid)
        self._tree_ctx_iid = iid
        try:
            self._tree_menu.tk_popup(event.x_root, event.y_root)
        finally:
            self._tree_menu.grab_release()

    def _tree_fix_match(self):
        iid = getattr(self, "_tree_ctx_iid", None) or (self.tree.selection()[0] if self.tree.selection() else None)
        if iid:
            self._bind_row_to_search(iid, run_search=True)

    def _tree_focus_search(self):
        iid = getattr(self, "_tree_ctx_iid", None) or (self.tree.selection()[0] if self.tree.selection() else None)
        if iid:
            self._bind_row_to_search(iid, run_search=False)
        self._search_panel._entry.focus_set()
    def _on_manual_override(self, result, iid):
        result = normalize_search_result(dict(result))
        folder = self.folder_var.get().strip()
        row_data = self.renames.get(iid)
        if not row_data:
            messagebox.showwarning(
                "Row not found",
                "Could not find that file in the scan list.\n\nClick the file row on the right, then apply a search result.",
            )
            return
        old_path = row_data.old_path
        if not folder:
            folder = os.path.dirname(old_path) or "."
        ext = os.path.splitext(old_path)[1]
        stem = os.path.splitext(os.path.basename(old_path))[0]
        _, _, type_hint = parse_stem(stem)
        mt = result.get("media_type", "movie")
        if mt=="tv" or (isinstance(type_hint,tuple) and type_hint[0]=="tv"):
            dl_season=type_hint[1] if isinstance(type_hint,tuple) else 1
            dl_episode=type_hint[2] if isinstance(type_hint,tuple) else 1
            tmdb_api = self._tmdb(self.api_var.get().strip())
            season, episode, _, _ = resolve_tv_season_episode(
                tmdb_api, result["id"], dl_season, dl_episode,
                flat_remap_enabled=self.flat_season_remap_var.get(),
            )
            show=sanitize(result.get("name") or result.get("title") or "Unknown Show")
            try:
                ep=tmdb_api.episode(result["id"],season,episode)
                ept=ep.get("name") if ep else None
            except Exception: ept=None
            new_name=build_tv_episode_filename(show, season, episode, ept, ext)
            genre_ids=result.get("genre_ids",[]); new_type="Anime" if 16 in genre_ids else "TV Show"
            genre_str = self._genres.label(genre_ids, "tv")
            # ── build nested TV path ──────────────────────────────────────
            dest_folder=self._resolve_dest(new_type,genre_ids,folder, title=show)
            new_path=build_tv_path(dest_folder,show,season,new_name)
        else:
            mtitle=sanitize(result.get("title") or result.get("name") or "Unknown")
            date=result.get("release_date") or ""; rel_year=date[:4] if date else ""
            new_name=f"{mtitle} ({rel_year}){ext}" if rel_year else f"{mtitle}{ext}"
            genre_ids=result.get("genre_ids",[]); new_type="Movie"
            genre_str = self._genres.label(genre_ids, "movie")
            dest_folder=self._resolve_dest(new_type,genre_ids,folder, title=mtitle)
            new_path=os.path.join(dest_folder,new_name)
        cur=self.tree.item(iid,"values")
        op = self._plan_file_op(old_path, new_path, new_type, genre_ids)
        self.renames[iid] = RenameRow(old_path, new_path, new_type, genre_ids, "Manual", op)
        self.tree.item(iid,values=(cur[0],os.path.basename(old_path),new_name,new_type,genre_str,"Manual"),tags=("manual",))
        orig = os.path.basename(old_path)
        self._unmatched_export = [u for u in self._unmatched_export if u.get("original") != orig]
        self.status_var.set(f"✏ Overridden → {new_name}")
        self._search_panel._refresh_target_banner()
        if result.get("id"):
            mt2 = "tv" if new_type in ("TV Show", "Anime") else "movie"
            self._cache_apply_update((old_path, {"id": result["id"], "media_type": mt2}))
            self._schedule_cache_save()
        pp=result.get("poster_path")
        if pp: threading.Thread(target=self._load_main_poster,args=(iid,pp),daemon=True).start()
        _toast(self, f"✓ Override applied: {new_name[:50]}", color=BLUE, duration=2500)
    def _resolve_dest(self, type_str, genre_ids, source, title: str = ""):
        def pick(var, fallback=""):
            v = var.get().strip() if hasattr(var, "get") else (var or "")
            if v and os.path.isdir(v):
                return v
            return fallback if fallback and os.path.isdir(fallback) else source
        if type_str in ("TV Show", "Anime"):
            return pick(self.dest_tv_var, self._server_tv_root)
        if self._genre_folder_map and genre_ids:
            folder = genre_folder_for_ids(
                genre_ids, self._genre_folder_map, title=title, genres=self._genres,
            )
            if folder:
                return folder
        other = self.dest_other_var.get().strip()
        if other and os.path.isdir(other):
            return other
        movies_root = (
            self.dest_movies_var.get().strip()
            or self._server_movies_root
            or self.server_var.get().strip()
        )
        if movies_root and os.path.isdir(movies_root):
            return movies_root
        return source
    def _scan_media_folders(self):
        """Scan Server (and optional Movies folder) for genre subfolders."""
        self._genre_folder_map.clear()
        self._server_movies_root = ""
        self._server_tv_root = ""
        genre_labels: list[str] = []
        server = self.server_var.get().strip()
        if server and os.path.isdir(server):
            try:
                top = sorted(
                    f for f in os.listdir(server)
                    if os.path.isdir(os.path.join(server, f))
                )
            except OSError:
                top = []
            for name in top:
                low = name.lower()
                full = os.path.join(server, name)
                if low in ("movies", "movie", "films", "film"):
                    self._server_movies_root = full
                    try:
                        kids = sorted(
                            f for f in os.listdir(full)
                            if os.path.isdir(os.path.join(full, f))
                        )
                    except OSError:
                        kids = []
                    for g in kids:
                        register_genre_folder(self._genre_folder_map, g, full)
                        genre_labels.append(g)
                elif low in ("tv shows", "tv", "television", "series", "shows"):
                    self._server_tv_root = full
                    if not self.dest_tv_var.get().strip():
                        self.dest_tv_var.set(full)
                elif low not in SERVER_LIBRARY_NAMES:
                    register_genre_folder(self._genre_folder_map, name, server)
                    genre_labels.append(name)
            if not self._server_movies_root:
                self._server_movies_root = server
            if not self.dest_movies_var.get().strip():
                self.dest_movies_var.set(self._server_movies_root)
        movies_override = self.dest_movies_var.get().strip()
        if movies_override and os.path.isdir(movies_override) and movies_override != server:
            try:
                extra = sorted(
                    f for f in os.listdir(movies_override)
                    if os.path.isdir(os.path.join(movies_override, f))
                )
            except OSError:
                extra = []
            for g in extra:
                register_genre_folder(self._genre_folder_map, g, movies_override)
                if g not in genre_labels:
                    genre_labels.append(g)
            self._server_movies_root = movies_override
        if genre_labels:
            display = "  📁 " + "   📁 ".join(genre_labels[:24])
            if len(genre_labels) > 24:
                display += f"  … (+{len(genre_labels) - 24} more)"
            self._folder_hint_lbl.config(
                text=f"Server genres detected:{display}  •  movies route into matching folders"
            )
        elif server:
            self._folder_hint_lbl.config(
                text="Server set, but no genre subfolders found — add folders like Sci-Fi, Romance, Action, etc."
            )
        else:
            self._folder_hint_lbl.config(
                text="Server: browse your library root — genre subfolders (Sci-Fi, Romance, …) are detected automatically"
            )
    def _clear(self):
        self.tree.delete(*self.tree.get_children()); self.renames.clear()
        self._unmatched_export.clear()
        self._main_poster_imgs.clear(); self._search_panel.clear_target()
        self._search_panel._build_idle_state()
        self._progress_var.set(0)
        self.status_var.set("Cleared.")

    def _update_apply_button(self):
        if self.dry_run_var.get():
            self._apply_btn.config(
                text="📋 Show apply plan (dry run)",
                bg=BLUE,
                activebackground="#2a5080",
            )
        else:
            self._apply_btn.config(
                text="✅ Apply Renames",
                bg=GREEN,
                activebackground="#2ea043",
            )

    def _tmdb(self, key: str) -> TMDB:
        return TMDB(key, slow_mode=self.slow_mode_var.get())

    def _jellyfin(self) -> JellyfinClient | None:
        client = JellyfinClient(
            self.jellyfin_url_var.get(),
            self.jellyfin_key_var.get(),
            resolved_base=getattr(self, "_jellyfin_resolved", "") or None,
        )
        return client if client.configured() else None

    def _test_jellyfin(self):
        client = self._jellyfin()
        if not client:
            messagebox.showwarning(
                "Jellyfin",
                "Enter your Jellyfin URL (e.g. http://192.168.1.10:8096) and API key.",
            )
            return
        self.status_var.set("Testing Jellyfin connection…")

        def work():
            ok, msg = client.test_connection()
            self.after(0, lambda: self._jellyfin_test_done(ok, msg, client))

        threading.Thread(target=work, daemon=True).start()

    def _jellyfin_test_done(self, ok: bool, msg: str, client: JellyfinClient | None = None):
        if ok and client and client.api_root:
            self._jellyfin_resolved = client.api_root
            if normalize_jellyfin_url(self.jellyfin_url_var.get()) != client.api_root:
                self.jellyfin_url_var.set(client.api_root)
            self._save_cfg()
            self.status_var.set(f"Jellyfin: {msg}")
            _toast(self, f"✓ {msg}", color=GREEN)
        elif ok:
            self.status_var.set(f"Jellyfin: {msg}")
            _toast(self, f"✓ {msg}", color=GREEN)
        else:
            self.status_var.set("Jellyfin connection failed")
            messagebox.showerror("Jellyfin connection failed", msg)

    def _scan_jellyfin_now(self):
        client = self._jellyfin()
        if not client:
            messagebox.showwarning(
                "Jellyfin",
                "Set Jellyfin Server URL and API key first.\n\n"
                "In Jellyfin: Dashboard → API Keys → create a key with admin access.",
            )
            return
        self.status_var.set("Starting Jellyfin library scan…")

        def work():
            ok, msg = client.refresh_all_libraries()
            self.after(0, lambda: self._jellyfin_scan_done(ok, msg))

        threading.Thread(target=work, daemon=True).start()

    def _jellyfin_scan_done(self, ok: bool, msg: str):
        if ok:
            self.status_var.set(msg)
            _toast(self, f"✓ {msg}", color=GREEN, duration=4500)
            messagebox.showinfo("Jellyfin", msg + "\n\nNew names should appear after the scan finishes.")
        else:
            self.status_var.set(f"Jellyfin: {msg}")
            messagebox.showerror("Jellyfin scan failed", msg)

    def _trigger_jellyfin_after_apply(self, changed_paths: list[str]):
        if not self.jellyfin_auto_scan_var.get():
            return
        client = self._jellyfin()
        if not client:
            log_line("Jellyfin auto-scan skipped (not configured)")
            return
        self.status_var.set("Notifying Jellyfin…")

        def work():
            ok, msg = client.notify_paths_updated(changed_paths)
            if not ok:
                ok, msg = client.refresh_all_libraries()

            def done():
                if ok:
                    self.status_var.set(msg)
                    _toast(self, f"✓ {msg}", color=GREEN, duration=4500)
                else:
                    self.status_var.set(f"Renames done; Jellyfin: {msg}")

            self.after(0, done)

        threading.Thread(target=work, daemon=True).start()

    def _track_unmatched(self, original: str, old_path: str, status: str, parsed_title: str, year):
        if status in ("No Match", "No genre folder", "API Error", "Exists"):
            self._unmatched_export.append({
                "original": original,
                "path": old_path,
                "parsed_title": parsed_title,
                "year": year or "",
                "status": status,
            })

    def _export_unmatched(self):
        if not self._unmatched_export and not self.renames:
            messagebox.showinfo("Nothing to export", "Scan a folder first.")
            return
        rows = list(self._unmatched_export)
        if not rows:
            for iid, d in self.renames.items():
                if d.skip_apply:
                    stem = os.path.splitext(os.path.basename(d.old_path))[0]
                    title, year, _ = parse_stem(stem)
                    rows.append({
                        "original": os.path.basename(d.old_path),
                        "path": d.old_path,
                        "parsed_title": title,
                        "year": year or "",
                        "status": d.status,
                    })
        if not rows:
            messagebox.showinfo("All matched", "No unmatched or skipped files in the current list.")
            return
        path = filedialog.asksaveasfilename(
            title="Save unmatched list",
            defaultextension=".csv",
            filetypes=[("CSV", "*.csv"), ("All", "*.*")],
            initialfile=f"unmatched_{datetime.datetime.now().strftime('%Y%m%d_%H%M')}.csv",
        )
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8") as f:
                w = csv.DictWriter(f, fieldnames=["original", "path", "parsed_title", "year", "status"])
                w.writeheader()
                w.writerows(rows)
            log_line(f"Exported {len(rows)} unmatched rows to {path}")
            messagebox.showinfo("Exported", f"Saved {len(rows)} row(s) to:\n{path}")
        except OSError as e:
            messagebox.showerror("Export failed", friendly_error(e, context="export"))

    def _collect_planned_ops(self) -> tuple[list, list, float]:
        """Return (operations, errors_preview, total_mb)."""
        policy = self.conflict_var.get()
        to_do: list[tuple] = []
        preview_errors: list[str] = []
        total_mb = 0.0
        for iid, d in self.renames.items():
            if d.skip_apply:
                continue
            old, new = d.old_path, d.new_path
            op = d.op
            if op != "copy" and os.path.normcase(old) == os.path.normcase(new):
                continue
            final = resolve_target_path(new, policy)
            if final is None:
                preview_errors.append(f"Skip (exists): {os.path.basename(new)}")
                continue
            if os.path.exists(final) and policy == "Overwrite" and os.path.normcase(old) != os.path.normcase(final):
                pass
            elif os.path.exists(final) and os.path.normcase(old) != os.path.normcase(final) and policy != "Overwrite":
                preview_errors.append(f"Skip (exists): {os.path.basename(final)}")
                continue
            if os.path.isfile(old):
                total_mb += file_size_mb(old)
            to_do.append((iid, old, final, op))
        return to_do, preview_errors, total_mb
    def _begin_scan(self) -> bool:
        if not self._scan_lock.acquire(blocking=False):
            return False
        self._scan_cancel.clear()
        self._pending_manual = 0
        self._manual_completed = 0
        self._manual_finished.clear()
        self._set_scan_buttons_state(scanning=True)
        return True

    def _end_scan(self):
        self._set_scan_buttons_state(scanning=False)
        try:
            self._scan_lock.release()
        except RuntimeError:
            pass

    def _cancel_scan(self):
        self._scan_cancel.set()
        self.status_var.set("Cancelling scan…")

    def _set_scan_buttons_state(self, *, scanning: bool):
        scan_state = "disabled" if scanning else "normal"
        cancel_state = "normal" if scanning else "disabled"
        for btn in (getattr(self, "_scan_btn", None), getattr(self, "_genre_scan_btn", None)):
            if btn is not None:
                try:
                    btn.config(state=scan_state)
                except tk.TclError:
                    pass
        cancel_btn = getattr(self, "_cancel_scan_btn", None)
        if cancel_btn is not None:
            try:
                cancel_btn.config(state=cancel_state)
            except tk.TclError:
                pass

    def _scan(self):
        key=self.api_var.get().strip(); folder=self.folder_var.get().strip()
        if not key: messagebox.showwarning("API Key Missing","Enter your TMDB API key."); return
        if not folder or not os.path.isdir(folder): messagebox.showwarning("Folder Missing","Select a valid media folder."); return
        if not self._begin_scan():
            _toast(self, "A scan is already running — wait for it to finish.", color=GOLD, duration=3500)
            return
        self._clear(); self.status_var.set("Scanning…")
        threading.Thread(target=self._run_scan,args=(key,folder),daemon=True).start()

    def _run_scan(self, key: str, folder: str):
        try:
            self._do_scan(key, folder)
        finally:
            self.after(0, self._end_scan)
    def _do_scan(self, key: str, folder: str):
        self._genres.load(key)
        tmdb = self._tmdb(key)
        services = self._scan_services()
        files = [f for f in os.listdir(folder) if os.path.splitext(f)[1].lower() in VIDEO_EXT]
        total = len(files)
        matched = 0
        cancelled = False
        for i, fname in enumerate(files, 1):
            if self._scan_cancel.is_set():
                cancelled = True
                break
            pct = (i / total) * 100 if total else 0
            self.after(0, self._progress_var.set, pct)
            self.after(0, self.status_var.set, f"Processing {i}/{total}: {fname}")
            outcome = resolve_file_match(
                tmdb, self._genres, fname, folder, self._id_cache, services,
                cancel_event=self._scan_cancel,
            )
            if outcome.status == "Cancelled":
                cancelled = True
                break
            if outcome.cache_update:
                self._cache_apply_update(outcome.cache_update)
            if outcome.manual_job:
                outcome.manual_job.api_key = key
                self.after(0, lambda o=outcome: self._queue_manual_pick(o))
            else:
                if outcome.matched:
                    matched += 1
                if outcome.api_error:
                    self.after(0, lambda msg=outcome.api_error: _toast(
                        self, f"API error: {msg[:60]}", color=ACCENT, duration=4000,
                    ))
                self.after(0, lambda o=outcome: self._apply_outcome_row(o))
        self._schedule_cache_save()
        self.after(0, self._progress_var.set, 100)
        if cancelled:
            summary = f"Cancelled — {matched}/{total} matched before stop"
        else:
            summary = f"Done — {matched}/{total} matched"
        if self._pending_manual:
            summary += f"  •  {self._pending_manual} awaiting picker"
        if self._manual_completed:
            summary += f" ({self._manual_completed} via manual picker)"
        summary += "  •  Click any row to instantly search & override."
        self.after(0, lambda s=summary: self.status_var.set(s))

    def _apply_outcome_row(self, outcome: FileMatchOutcome) -> str:
        iid = self.tree.insert(
            "", "end",
            values=("", outcome.fname, outcome.new_name, outcome.type_str, outcome.genre_str, outcome.status),
            tags=(outcome.tag,),
        )
        self.renames[iid] = RenameRow(
            outcome.old_path, outcome.new_path, outcome.type_str,
            outcome.genre_ids, outcome.status, outcome.op,
        )
        title, year, _ = parse_stem(os.path.splitext(outcome.fname)[0])
        if outcome.tag == "no_match" or outcome.status in (
            "No Match", "No genre folder", "API Error", "Pick match…",
        ) or "Exists" in outcome.status:
            self._track_unmatched(outcome.fname, outcome.old_path, outcome.status, title, year)
        if outcome.poster_path:
            threading.Thread(
                target=self._load_main_poster, args=(iid, outcome.poster_path), daemon=True,
            ).start()
        return iid

    def _update_row_from_outcome(self, iid: str, outcome: FileMatchOutcome):
        if not self.tree.exists(iid):
            return
        self.renames[iid] = RenameRow(
            outcome.old_path, outcome.new_path, outcome.type_str,
            outcome.genre_ids, outcome.status, outcome.op,
        )
        cur = self.tree.item(iid, "values")
        self.tree.item(
            iid,
            values=(cur[0], outcome.fname, outcome.new_name, outcome.type_str, outcome.genre_str, outcome.status),
            tags=(outcome.tag,),
        )
        title, year, _ = parse_stem(os.path.splitext(outcome.fname)[0])
        if outcome.tag != "no_match" and outcome.status not in (
            "No Match", "No genre folder", "API Error", "Pick match…",
        ):
            orig = outcome.fname
            self._unmatched_export = [u for u in self._unmatched_export if u.get("original") != orig]
        if outcome.poster_path:
            threading.Thread(
                target=self._load_main_poster, args=(iid, outcome.poster_path), daemon=True,
            ).start()

    def _queue_manual_pick(self, outcome: FileMatchOutcome, old_path: str = ""):
        job = outcome.manual_job
        if not job:
            return
        iid = self._apply_outcome_row(outcome)
        self._pending_manual += 1
        self._manual_seq += 1
        req_id = self._manual_seq
        self._picker_q.put((
            req_id, job.api_key, job.title, job.results, job.fname, iid, job, old_path,
        ))
        if self._pending_manual == 1:
            self.status_var.set(f"Pick match for {job.fname}… (scan continues in background)")

    def _finish_manual_pick(self, iid: str, job: ManualPickJob, chosen: dict | None, old_path: str = ""):
        if iid in self._manual_finished:
            return
        self._manual_finished.add(iid)
        self._pending_manual = max(0, self._pending_manual - 1)
        pick_source = "manual"
        chosen_final = chosen
        if chosen is None and job.auto_best:
            chosen_final = dict(job.auto_best)
            chosen_final.setdefault("media_type", job.media_kind)
            pick_source = "auto"
        tmdb = self._tmdb(job.api_key)
        out = complete_manual_pick(
            job, chosen_final, tmdb, self._genres, self._scan_services(), pick_source=pick_source,
        )
        if out.cache_update:
            self._cache_apply_update(out.cache_update)
            self._schedule_cache_save()
        if job.mode == "genre" and old_path and out.matched:
            title, _, _ = parse_stem(os.path.splitext(job.fname)[0])
            out = self._apply_genre_movie_outcome(out, old_path, title, out.result)
            if out.op == "copy" and out.tag == "matched":
                pass
        if out.manual_via:
            self._manual_completed += 1
        self._update_row_from_outcome(iid, out)

    def _add_row(self, original, new_name, type_str, genre_str, status, tag, old_path, new_path, genre_ids, poster_path="", op="move"):
        """Legacy helper — prefer _apply_outcome_row."""
        return self._apply_outcome_row(FileMatchOutcome(
            fname=original, new_name=new_name, type_str=type_str, genre_str=genre_str,
            status=status, tag=tag, old_path=old_path, new_path=new_path,
            genre_ids=genre_ids, poster_path=poster_path, op=op,
        ))
    def _load_main_poster(self,iid,poster_path):
        try:
            resp=requests.get(f"{TMDB_IMG_45}{poster_path}",timeout=8)
            if not resp.ok: return
            photo=bytes_to_photo(resp.content,MAIN_POSTER_W,MAIN_POSTER_H)
            if photo is None: return
            self._main_poster_imgs[iid]=photo
            def _apply():
                if self.tree.exists(iid): self.tree.item(iid,image=photo)
            self.after(0,_apply)
        except Exception: pass
    def _poll_picker_q(self):
        if self._picker_active:
            self.after(150, self._poll_picker_q)
            return
        try:
            item = self._picker_q.get_nowait()
        except queue.Empty:
            self.after(150, self._poll_picker_q)
            return

        _req_id, key, title, results, fname, iid, job, old_path = item
        self._picker_active = True
        done = threading.Event()

        def _picker_finished(chosen):
            self._cancel_picker_timeout()
            self._picker_active = False
            self.after(0, lambda: self._finish_manual_pick(iid, job, chosen, old_path))
            self.after(50, self._poll_picker_q)

        try:
            dlg = _MiniPicker(self, key, title, results, fname, done)
        except tk.TclError as exc:
            log_line(f"picker open failed ({fname}): {exc}")
            _picker_finished(None)
            return

        def _wait(dlg_ref=dlg, j=job, row_iid=iid, op=old_path):
            if done.is_set():
                _picker_finished(dlg_ref.chosen)
                return
            try:
                if not dlg_ref.winfo_exists():
                    _picker_finished(None)
                    return
            except tk.TclError:
                _picker_finished(None)
                return
            self.after(80, _wait)

        self._schedule_picker_timeout(dlg, done, job)
        self.after(80, _wait)

    def _cancel_picker_timeout(self):
        aid = self._picker_timeout_after_id
        if aid is not None:
            try:
                self.after_cancel(aid)
            except tk.TclError:
                pass
        self._picker_timeout_after_id = None

    def _schedule_picker_timeout(self, dlg, done: threading.Event, job: ManualPickJob):
        self._cancel_picker_timeout()
        self._picker_timeout_after_id = self.after(
            int(MANUAL_PICK_TIMEOUT_SEC * 1000),
            lambda d=dlg, ev=done, j=job: self._on_picker_timeout(d, ev, j),
        )

    def _on_picker_timeout(self, dlg, done: threading.Event, job: ManualPickJob):
        self._picker_timeout_after_id = None
        if done.is_set():
            return
        try:
            parent = dlg if dlg.winfo_exists() else self
        except tk.TclError:
            parent = self
        keep = messagebox.askyesno(
            "Still working on this file?",
            f"You're still choosing a match for:\n\n{job.fname}\n\n"
            "• Yes = Keep waiting\n• No = Skip this file for now",
            parent=parent,
        )
        if keep:
            self._schedule_picker_timeout(dlg, done, job)
            return
        log_line(f"manual pick skipped by user: {job.fname}")
        try:
            dlg.destroy()
        except tk.TclError:
            pass
        done.set()
        _toast(self, f"Skipped {job.fname}", color=GOLD, duration=4000)

    def _maybe_show_api_onboarding(self):
        if self.api_var.get().strip():
            self._refresh_api_key_banner()
            return
        if getattr(self, "_api_wizard_shown", False):
            self._refresh_api_key_banner()
            return
        self._api_wizard_shown = True
        ApiKeyWizard(self, self.api_var, on_save=self._on_api_key_saved)

    def _on_api_key_saved(self):
        self._save_cfg()
        self._refresh_api_key_banner()

    def _refresh_api_key_banner(self):
        if self._api_banner is not None:
            self._api_banner.destroy()
            self._api_banner = None
        if self.api_var.get().strip():
            return
        banner = tk.Frame(self, bg="#3d2a00", padx=10, pady=8)
        try:
            banner.pack(fill="x", before=self._progress)
        except tk.TclError:
            banner.pack(fill="x")
        tk.Label(
            banner,
            text="⚠ TMDB API key required — search and auto-match won't work until you add one.",
            font=FONT_SM,
            fg=GOLD,
            bg="#3d2a00",
            anchor="w",
        ).pack(side="left", fill="x", expand=True)
        tk.Button(
            banner,
            text="Set up API key…",
            font=FONT_SM,
            bg=ACCENT,
            fg="white",
            relief="flat",
            bd=0,
            padx=10,
            pady=4,
            command=lambda: ApiKeyWizard(self, self.api_var, on_save=self._on_api_key_saved),
        ).pack(side="right", padx=(8, 0))
        self._api_banner = banner
    def _apply(self):
        if not self.renames:
            messagebox.showinfo("Nothing to do", "Scan a folder first.")
            return
        to_do, preview_errors, total_mb = self._collect_planned_ops()
        if not to_do:
            extra = "\n".join(preview_errors[:8])
            if len(preview_errors) > 8:
                extra += f"\n… and {len(preview_errors) - 8} more"
            messagebox.showinfo(
                "Nothing to do",
                "No files to move or copy."
                + (f"\n\nSkipped:\n{extra}" if extra else ""),
            )
            return
        n_copy = sum(1 for *_, op in to_do if op == "copy")
        n_move = len(to_do) - n_copy
        policy = self.conflict_var.get()

        if self.dry_run_var.get():
            sample = "\n".join(
                f"  • {os.path.basename(old)}\n    → {new}"
                for _, old, new, _ in to_do[:10]
            )
            if len(to_do) > 10:
                sample += f"\n  … and {len(to_do) - 10} more"
            msg = (
                f"DRY RUN — no files changed\n\n"
                f"{len(to_do)} operation(s) (~{total_mb:.1f} MB)\n"
                f"  Copy: {n_copy}  |  Move/rename: {n_move}\n"
                f"  Conflict policy: {policy}\n"
            )
            if preview_errors:
                msg += f"  Would skip: {len(preview_errors)} (already exists)\n"
            msg += f"\n{sample}\n\nUncheck Preview only, then Apply again to run for real."
            log_line(f"Dry run: {len(to_do)} ops, ~{total_mb:.1f} MB, copy={n_copy} move={n_move}")
            messagebox.showinfo("Apply plan (dry run)", msg)
            self.status_var.set(f"Dry run: {len(to_do)} ready — uncheck Preview only to apply.")
            return

        msg = [
            f"Apply {len(to_do)} change(s) (~{total_mb:.1f} MB)?",
            f"  Copy: {n_copy}  |  Move/rename: {n_move}",
            f"  If exists: {policy}",
        ]
        if preview_errors:
            msg.append(f"  ({len(preview_errors)} skipped — already exists)")
        msg.append("\nHistory will be saved so you can undo.")
        if not messagebox.askyesno("Confirm apply", "\n".join(msg)):
            return

        errors: list[str] = []
        batch_log: list[dict] = []
        for iid, old, new, op in to_do:
            try:
                os.makedirs(os.path.dirname(new) or ".", exist_ok=True)
                if (
                    os.path.exists(new)
                    and policy == "Overwrite"
                    and os.path.normcase(old) != os.path.normcase(new)
                ):
                    if os.path.isfile(new):
                        os.remove(new)
                if op == "copy":
                    shutil.copy2(old, new)
                else:
                    shutil.move(old, new)
                batch_log.append({"old_path": old, "new_path": new, "op": op})
                log_line(f"{op}: {old} -> {new}")
            except Exception as e:
                errors.append(f"{os.path.basename(old)}: {e}")
                log_line(f"ERROR {old}: {e}")
        if batch_log:
            append_history(batch_log)
        changed_paths = [entry["new_path"] for entry in batch_log]
        if errors:
            messagebox.showwarning("Some errors", "\n".join(errors))
            if batch_log:
                self._trigger_jellyfin_after_apply(changed_paths)
        else:
            parts = []
            if n_copy:
                parts.append(f"copied {n_copy}")
            if n_move:
                parts.append(f"moved {n_move}")
            jf_note = (
                "\n\nJellyfin library scan is starting automatically."
                if self.jellyfin_auto_scan_var.get() and self._jellyfin()
                else "\n\nEnable Jellyfin auto-scan in settings, or click Scan Jellyfin now."
            )
            messagebox.showinfo(
                "Done!",
                f"Successfully {' and '.join(parts)} file(s)."
                + jf_note
                + "\n\nUse History & Undo to reverse if needed.",
            )
            _toast(self, f"✓ {' and '.join(parts)}", color=GREEN)
            self._trigger_jellyfin_after_apply(changed_paths)
        self._clear()
if __name__=="__main__":
    app=MediaRenamer(); app.mainloop()
