def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            log_line(f"config load failed: {e}")
    return {}

def save_config(cfg):
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except OSError as e:
        log_line(f"config save failed: {e}")
def norm_cache_key(path: str) -> str:
    return os.path.normcase(os.path.normpath(os.path.abspath(path)))

def load_id_cache() -> dict:
    if not os.path.exists(ID_CACHE_FILE):
        return {}
    try:
        with open(ID_CACHE_FILE, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        log_line(f"id_cache load failed: {e}")
        return {}
    if not isinstance(raw, dict):
        return {}
    out: dict = {}
    for k, v in raw.items():
        if not isinstance(v, dict) or not v.get("id"):
            continue
        if os.path.isabs(k) or os.sep in k.replace("/", os.sep):
            out[norm_cache_key(k)] = v
        else:
            out[k] = v
    return out

def save_id_cache(cache: dict) -> None:
    try:
        with open(ID_CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump(cache, f, indent=2)
    except OSError as e:
        log_line(f"id_cache save failed: {e}")

def id_cache_get(cache: dict, file_path: str) -> dict | None:
    key = norm_cache_key(file_path)
    hit = cache.get(key)
    if isinstance(hit, dict) and hit.get("id"):
        return hit
    fname = os.path.basename(file_path)
    legacy = cache.get(fname)
    if isinstance(legacy, dict) and legacy.get("id"):
        return legacy
    return None

def id_cache_set(cache: dict, file_path: str, value: dict) -> str:
    key = norm_cache_key(file_path)
    cache[key] = value
    fname = os.path.basename(file_path)
    if fname in cache and fname != key:
        del cache[fname]
    return key
@dataclass
class GenreCache:
    movies: dict = field(default_factory=dict)
    tv: dict = field(default_factory=dict)

    def load(self, api_key: str) -> None:
        try:
            r = requests.get(f"{TMDB_BASE}/genre/movie/list", params={"api_key": api_key}, timeout=10)
            r.raise_for_status()
            self.movies = {g["id"]: g["name"] for g in r.json().get("genres", [])}
            r = requests.get(f"{TMDB_BASE}/genre/tv/list", params={"api_key": api_key}, timeout=10)
            r.raise_for_status()
            self.tv = {g["id"]: g["name"] for g in r.json().get("genres", [])}
        except requests.exceptions.RequestException as e:
            log_line(f"genre list load failed: {e}")

    def combined(self) -> dict:
        return {**self.movies, **self.tv}

    def label(self, genre_ids: list, media: str) -> str:
        gmap = self.tv if media == "tv" else self.movies
        return genre_label(genre_ids, gmap)


