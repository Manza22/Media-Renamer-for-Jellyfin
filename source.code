def log_line(msg: str):
    try:
        ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] {msg}\n")
    except OSError:
        pass

def resolve_target_path(target: str, policy: str) -> str | None:
    """Pick final path when target exists. None = skip this file."""
    if not os.path.exists(target):
        return target
    if policy == "Skip if exists":
        return None
    if policy == "Overwrite":
        return target
    base, ext = os.path.splitext(target)
    n = 2
    candidate = f"{base} ({n}){ext}"
    while os.path.exists(candidate):
        n += 1
        candidate = f"{base} ({n}){ext}"
    return candidate

def file_size_mb(path: str) -> float:
    try:
        return os.path.getsize(path) / (1024 * 1024)
    except OSError:
        return 0.0

# ─────────────────────────────────────────────────────────────────────────────
#  HISTORY / UNDO SYSTEM
# ─────────────────────────────────────────────────────────────────────────────
def load_history() -> list:
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            log_line(f"history load failed: {e}")
    return []

def save_history(history: list):
    try:
        with open(HISTORY_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f, indent=2)
    except OSError as e:
        log_line(f"history save failed: {e}")
def append_history(batch: list[dict]):
    history = load_history()
    history.append({
        "timestamp": datetime.datetime.now().isoformat(),
        "batch_id": datetime.datetime.now().strftime("%Y%m%d_%H%M%S"),
        "renames": batch,
    })
    if len(history) > HISTORY_MAX_BATCHES:
        history = history[-HISTORY_MAX_BATCHES:]
    save_history(history)
def undo_batch(batch: dict) -> tuple[int, list]:
    ok = 0; errors = []
    for entry in batch["renames"]:
        old = entry["old_path"]
        new = entry["new_path"]
        op = entry.get("op", "move")
        try:
            if op == "copy":
                if not os.path.exists(new):
                    errors.append(f"Copy not found: {os.path.basename(new)}")
                    continue
                os.remove(new)
                ok += 1
                continue
            if not os.path.exists(new):
                errors.append(f"Not found: {os.path.basename(new)}")
                continue
            if os.path.exists(old):
                errors.append(f"Destination exists: {os.path.basename(old)}")
                continue
            os.makedirs(os.path.dirname(old) or ".", exist_ok=True)
            shutil.move(new, old)
            ok += 1
        except Exception as e:
            errors.append(f"{os.path.basename(new)}: {e}")
    return ok, errors
