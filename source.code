def app_base_dir() -> str:
    if getattr(sys, "frozen", False):
        return os.path.dirname(sys.executable)
    return os.path.dirname(os.path.abspath(__file__))

def _extract_icon_from_exe_windows(exe_path: str, ico_path: str) -> bool:
    exe_esc = exe_path.replace("'", "''")
    ico_esc = ico_path.replace("'", "''")
    ps = (
        "Add-Type -AssemblyName System.Drawing; "
        f"$i=[System.Drawing.Icon]::ExtractAssociatedIcon('{exe_esc}'); "
        f"$f=[System.IO.File]::Create('{ico_esc}'); $i.Save($f); $f.Close()"
    )
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command", ps],
            capture_output=True, text=True, timeout=30, check=False,
        )
        return (
            r.returncode == 0
            and os.path.isfile(ico_path)
            and os.path.getsize(ico_path) > 0
        )
    except (OSError, subprocess.SubprocessError) as e:
        log_line(f"icon extract from exe failed: {e}")
        return False

def _build_icon_via_packaging(base_dir: str, ico_path: str) -> bool:
    script = os.path.join(base_dir, "media_renamer_packaging", "make_icon.py")
    if not os.path.isfile(script):
        return False
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("mr_make_icon", script)
        if spec is None or spec.loader is None:
            return False
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        master = mod.draw_icon(mod.MASTER)
        mod.build_ico(master, Path(ico_path))
        return os.path.isfile(ico_path) and os.path.getsize(ico_path) > 0
    except Exception as e:
        log_line(f"make_icon import failed: {e}")
        return False

def ensure_app_icon(base_dir: str | None = None) -> str | None:
    """Resolve media_renamer.ico — prefer copy/extract matching MediaRenamer.exe."""
    meipass = getattr(sys, "_MEIPASS", None)
    if meipass:
        bundled = os.path.join(meipass, ICON_FILENAME)
        if os.path.isfile(bundled) and os.path.getsize(bundled) > 0:
            return bundled
    base = base_dir or app_base_dir()
    ico = os.path.join(base, ICON_FILENAME)
    if os.path.isfile(ico) and os.path.getsize(ico) > 0:
        return ico
    packaging_ico = os.path.join(base, "media_renamer_packaging", ICON_FILENAME)
    if os.path.isfile(packaging_ico):
        try:
            shutil.copy2(packaging_ico, ico)
            return ico
        except OSError as e:
            log_line(f"icon copy failed: {e}")
    if os.name == "nt":
        for name in ICON_SOURCE_EXE_NAMES:
            exe = os.path.join(base, name)
            if os.path.isfile(exe) and _extract_icon_from_exe_windows(exe, ico):
                log_line(f"icon extracted from {name}")
                return ico
    if _build_icon_via_packaging(base, ico):
        log_line("icon generated via media_renamer_packaging/make_icon.py")
        return ico
    return None

